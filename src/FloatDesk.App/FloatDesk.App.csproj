<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>YueYuOrb</AssemblyName>
    <RootNamespace>FloatDesk.App</RootNamespace>
    <AssemblyTitle>月语悬浮球</AssemblyTitle>
    <Product>月语悬浮球</Product>
    <Company>七月风语</Company>
    <Authors>七月风语</Authors>
    <Copyright>Copyright © 2026 七月风语</Copyright>
    <RepositoryUrl>https://github.com/AthiefEX/YueYuOrb</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FloatDesk.Core/FloatDesk.Core.csproj" />
    <ProjectReference Include="../FloatDesk.Infrastructure/FloatDesk.Infrastructure.csproj" />
    <ProjectReference Include="../FloatDesk.Windows/FloatDesk.Windows.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
</Project>
