<Window x:Class="FloatDesk.App.Views.AiBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="680"
        Height="760"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource SettingsWindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="月语悬浮球 AI 网页">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YueYuOrb;component/Resources/SettingsWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ToolWindowShellStyle}">
        <Grid Background="{DynamicResource ToolWindowContentBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Grid x:Name="AiTitleBar"
                  Grid.Row="0"
                  Style="{StaticResource ToolWindowTitleBarStyle}"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="8"
                            Margin="0,0,9,0"
                            Background="{DynamicResource SettingsAccentBrush}">
                        <TextBlock Text="月"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="月语悬浮球 AI 网页"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsInkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="AiMinimizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化 AI 网页">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="12"
                                   Text="&#xE921;" />
                    </Button>
                    <Button x:Name="AiMaximizeRestoreButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMaximizeRestoreClick"
                            AutomationProperties.Name="最大化或还原 AI 网页">
                        <TextBlock x:Name="AiMaximizeGlyph"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="12"
                                   Text="&#xE922;" />
                    </Button>
                    <Button x:Name="AiCloseButton"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="OnCloseClick"
                            AutomationProperties.Name="关闭 AI 网页">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="12"
                                   Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource SettingsHeroBrush}"
                    CornerRadius="0,0,22,22"
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="月语悬浮球 AI 网页"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SettingsInkBrush}" />
                        <TextBlock Text="在一个独立窗口中快速访问常用 AI 站点"
                                   Margin="1,3,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource SettingsMutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{StaticResource SettingsPillStyle}"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="当前地址"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SettingsAccentBrush}" />
                            <TextBlock x:Name="AddressText"
                                       Margin="0,2,0,0"
                                       MaxWidth="230"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SettingsMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="20,14,20,0"
                    Style="{StaticResource ToolWindowToolbarStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SiteComboBox"
                              MinHeight="36"
                              DisplayMemberPath="Name"
                              SelectionChanged="OnSiteSelectionChanged"
                              Margin="0,0,8,0"
                              Style="{StaticResource SettingsComboBoxStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE72B;"
                                ToolTip="后退"
                                AutomationProperties.Name="后退"
                                Click="OnBackClick"
                                Margin="0,0,5,0"
                                Style="{StaticResource ToolbarIconButtonStyle}" />
                        <Button Content="&#xE72A;"
                                ToolTip="前进"
                                AutomationProperties.Name="前进"
                                Click="OnForwardClick"
                                Margin="0,0,5,0"
                                Style="{StaticResource ToolbarIconButtonStyle}" />
                        <Button Content="&#xE72C;"
                                ToolTip="刷新"
                                AutomationProperties.Name="刷新"
                                Click="OnRefreshClick"
                                Style="{StaticResource ToolbarIconButtonStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                        <Button ToolTip="在默认浏览器中打开"
                                Click="OnExternalClick"
                                Margin="0,0,6,0"
                                Style="{StaticResource ToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;"
                                           FontFamily="{StaticResource SettingsIconFont}"
                                           FontSize="15"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="浏览器打开" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PinButton"
                                Content="固定"
                                ToolTip="切换窗口置顶"
                                Click="OnPinClick"
                                Margin="0,0,6,0"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,10,0"
                                Background="{DynamicResource SettingsLineBrush}" />
                        <Button Content="&#xE71F;"
                                ToolTip="缩小网页"
                                AutomationProperties.Name="缩小网页"
                                Click="OnZoomOutClick"
                                Margin="0,0,6,0"
                                Style="{StaticResource ToolbarIconButtonStyle}" />
                        <TextBlock x:Name="ZoomText"
                                   Text="100%"
                                   MinWidth="44"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SettingsMutedBrush}"
                                   FontWeight="SemiBold" />
                        <Button Content="&#xE710;"
                                ToolTip="放大网页"
                                AutomationProperties.Name="放大网页"
                                Click="OnZoomInClick"
                                Margin="6,0,0,0"
                                Style="{StaticResource ToolbarIconButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="20,12,20,12"
                    Background="{DynamicResource ToolWindowEditorBrush}"
                    BorderBrush="{DynamicResource SettingsLineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True">
                <Grid x:Name="BrowserHost">
                    <Border x:Name="StatusPanel"
                            Background="{DynamicResource ToolWindowContentBrush}"
                            Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420">
                            <Border Width="54"
                                    Height="54"
                                    CornerRadius="18"
                                    Margin="0,0,0,14"
                                    Background="{DynamicResource SettingsAccentSoftBrush}">
                                <TextBlock Text="&#xE774;"
                                           FontFamily="{StaticResource SettingsIconFont}"
                                           FontSize="24"
                                           Foreground="{DynamicResource SettingsAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="StatusTitle"
                                       Text="网页暂时不可用"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SettingsInkBrush}"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="StatusDetail"
                                       Margin="0,10,0,16"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource SettingsMutedBrush}" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Content="重试"
                                        Click="OnRetryClick"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Margin="0,0,8,0" />
                                <Button Content="安装/修复 WebView2"
                                        Click="OnInstallRuntimeClick"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Content="用默认浏览器打开"
                                        Click="OnExternalClick"
                                        Style="{StaticResource ToolbarButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Margin="20,0,20,12"
                    Background="{DynamicResource SettingsCardSubtleBrush}"
                    BorderBrush="{DynamicResource SettingsLineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,0">
                <Grid>
                    <TextBlock x:Name="FooterText"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SettingsMutedBrush}"
                               Text="网页运行在独立浏览器进程中；月语悬浮球不向网页暴露本机命令接口。" />
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SettingsAccentSoftBrush}"
                            CornerRadius="9"
                            Padding="8,3">
                        <TextBlock Text="HTTPS · WebView2"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SettingsAccentBrush}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
