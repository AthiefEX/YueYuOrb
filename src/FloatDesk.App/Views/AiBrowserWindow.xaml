<Window x:Class="FloatDesk.App.Views.AiBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="680" Height="760" MinWidth="400" MinHeight="300"
        ShowActivated="False" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Title="月语悬浮浏览器">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YueYuOrb;component/Resources/SettingsWindowResources.xaml" />
                <ResourceDictionary Source="/YueYuOrb;component/Resources/BrightnessControlResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BrowserIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                <Setter Property="Width" Value="26" /><Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style x:Key="BrowserCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Width" Value="26" /><Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource SettingsIconFont}" /><Setter Property="FontSize" Value="12" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style x:Key="BrowserCloseButton" TargetType="Button" BasedOn="{StaticResource CloseCaptionButtonStyle}">
                <Setter Property="Width" Value="26" /><Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource SettingsIconFont}" /><Setter Property="FontSize" Value="12" />
                <Setter Property="ToolTip" Value="关闭浏览器" />
                <Setter Property="AutomationProperties.Name" Value="关闭浏览器" />
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            </Style>
            <Style x:Key="BrowserBookmarkItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,8" /><Setter Property="Margin" Value="0,2" />
                <Setter Property="Foreground" Value="{DynamicResource SettingsInkBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsAccentSoftBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsAccentSoftBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource ToolWindowShellStyle}">
        <Grid Background="{DynamicResource ToolWindowContentBrush}">
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="AiTitleBar" Grid.Row="0" Background="{DynamicResource ToolWindowTitleBarBrush}"
                  Margin="7,0,4,0" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,5,0" ToolTip="悬浮浏览器 · 拖动此处移动窗口">
                    <Border Width="18" Height="18" CornerRadius="6" Background="{DynamicResource SettingsAccentBrush}">
                        <TextBlock Text="月" FontSize="9" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="BrowserCaption" Text="悬浮浏览器" FontSize="11" FontWeight="SemiBold"
                               Margin="5,0,3,0" VerticalAlignment="Center" Foreground="{DynamicResource SettingsInkBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE72B;" ToolTip="后退" Click="OnBackClick" Style="{StaticResource BrowserIconButton}" />
                    <Button Content="&#xE72A;" ToolTip="前进" Click="OnForwardClick" Style="{StaticResource BrowserIconButton}" />
                    <Button Content="&#xE72C;" ToolTip="刷新网页" Click="OnRefreshClick" Style="{StaticResource BrowserIconButton}" />
                </StackPanel>
                <TextBox x:Name="BrowserAddressInput" Grid.Column="2" MinWidth="56" Height="28" MinHeight="0"
                         FontSize="11" Padding="6,3" Margin="4,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                         Style="{StaticResource SettingsTextBoxStyle}" KeyDown="OnBrowserAddressKeyDown"
                         ToolTip="输入 HTTPS 网址，按 Enter 打开"
                         AutomationProperties.Name="网页地址" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Content="&#xE7C9;" ToolTip="切换穿透/交互" Click="OnPinClick" Style="{StaticResource BrowserIconButton}" />
                    <Button Content="&#xE774;" ToolTip="在系统浏览器中打开" Click="OnExternalClick" Style="{StaticResource BrowserIconButton}" />
                    <Button x:Name="BookmarkButton" Content="&#xE734;" ToolTip="收藏当前网页" Click="OnBookmarkClick" Style="{StaticResource BrowserIconButton}" />
                    <Button x:Name="BrowserAppearanceButton" Content="&#xE790;" ToolTip="透明度与网页缩放" Click="OnBrowserAppearanceClick" Style="{StaticResource BrowserIconButton}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                    <Button x:Name="AiMinimizeButton" Content="&#xE921;" ToolTip="最小化浏览器" Click="OnMinimizeClick" Style="{StaticResource BrowserCaptionButton}" />
                    <Button x:Name="BrowserBookmarksButton" ToolTip="收藏与书签" Click="OnBrowserBookmarksClick" Style="{StaticResource BrowserCaptionButton}">
                        <TextBlock Text="&#x22EE;" FontFamily="Segoe UI" FontSize="18" />
                    </Button>
                    <Button x:Name="AiMaximizeRestoreButton" ToolTip="最大化或还原" Click="OnMaximizeRestoreClick" Style="{StaticResource BrowserCaptionButton}">
                        <TextBlock x:Name="AiMaximizeGlyph" Text="&#xE922;" FontSize="12" />
                    </Button>
                    <Button x:Name="AiCloseButton" Content="&#xE8BB;" Click="OnCloseClick" Style="{StaticResource BrowserCloseButton}" />
                </StackPanel>
                <ComboBox x:Name="SiteComboBox" Visibility="Collapsed" DisplayMemberPath="Name" SelectionChanged="OnSiteSelectionChanged" />
                <TextBlock x:Name="AddressText" Visibility="Collapsed" />
                <TextBlock x:Name="FooterText" Visibility="Collapsed" Text="默认穿透；按快捷键切换交互后操作网页。" />
            </Grid>
            <Border x:Name="BrowserViewport" Grid.Row="1" Margin="4,0,4,4" Background="{DynamicResource ToolWindowEditorBrush}" CornerRadius="11" ClipToBounds="True"
                    ToolTip="{Binding Text, ElementName=FooterText}">
                <Grid x:Name="BrowserHost">
                    <Border x:Name="StatusPanel" Background="{DynamicResource ToolWindowContentBrush}" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Margin="16" MaxWidth="420" HorizontalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" Text="网页暂时不可用" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SettingsInkBrush}" TextAlignment="Center" />
                            <TextBlock x:Name="StatusDetail" Margin="0,8,0,14" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SettingsMutedBrush}" />
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="重试" Click="OnRetryClick" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,6,6" />
                                <Button Content="修复 WebView2" Click="OnInstallRuntimeClick" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,6" />
                                <Button Content="浏览器打开" Click="OnExternalClick" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Popup x:Name="BrowserAppearancePopup" PlacementTarget="{Binding ElementName=BrowserAppearanceButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="5">
                <Border Background="{DynamicResource SettingsPopupBrush}" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Width="240">
                    <StackPanel>
                        <DockPanel><TextBlock Text="窗口不透明度" Foreground="{DynamicResource SettingsInkBrush}" />
                            <TextBlock x:Name="BrowserOpacityLabel" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource SettingsAccentBrush}" /></DockPanel>
                        <Slider x:Name="BrowserOpacitySlider" Minimum="20" Maximum="100" Value="100" Margin="0,8,0,4"
                                Style="{StaticResource BrightnessSliderStyle}" ValueChanged="OnBrowserOpacityChanged" ToolTip="降低数值可看见后方窗口" />
                        <TextBlock Text="数值越低，后方画面越清晰" FontSize="11" Margin="0,0,0,14" Foreground="{DynamicResource SettingsMutedBrush}" />
                        <DockPanel>
                            <TextBlock Text="网页缩放" VerticalAlignment="Center" Foreground="{DynamicResource SettingsInkBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="&#xE738;" ToolTip="缩小网页" Click="OnZoomOutClick" Style="{StaticResource BrowserIconButton}" />
                                <TextBlock x:Name="ZoomText" Text="100%" Width="42" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource SettingsInkBrush}" />
                                <Button Content="&#xE710;" ToolTip="放大网页" Click="OnZoomInClick" Style="{StaticResource BrowserIconButton}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>
            <Popup x:Name="BrowserBookmarksPopup" PlacementTarget="{Binding ElementName=BrowserBookmarksButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="5">
                <Border Background="{DynamicResource SettingsPopupBrush}" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Width="300">
                    <StackPanel>
                        <TextBlock Text="收藏与书签" FontWeight="SemiBold" Margin="8,4,8,8" Foreground="{DynamicResource SettingsInkBrush}" />
                        <ListBox x:Name="BrowserBookmarksList" ItemsSource="{Binding ItemsSource, ElementName=SiteComboBox}"
                                 MaxHeight="350" Background="Transparent" BorderThickness="0" SelectionChanged="OnBrowserBookmarkSelected"
                                 ItemContainerStyle="{StaticResource BrowserBookmarkItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate>
                                <StackPanel ToolTip="{Binding Url}">
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Url.Host}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SettingsMutedBrush}" />
                                </StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
