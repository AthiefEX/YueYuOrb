<Window x:Class="FloatDesk.App.Views.OrbImageCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="裁切悬浮球图片"
        Width="860"
        Height="680"
        MinWidth="680"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SettingsWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YueYuOrb;component/Resources/SettingsWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="裁切悬浮球图片"
                       Style="{StaticResource SettingsSectionTitleStyle}" />
            <TextBlock Text="拖动选框调整位置，拖动四角缩放。悬浮球会使用选框内的方形区域。"
                       Style="{StaticResource SettingsDescriptionStyle}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,14"
                Padding="12"
                CornerRadius="16"
                Background="#FF14202B"
                BorderBrush="{DynamicResource SettingsLineBrush}"
                BorderThickness="1">
            <Grid x:Name="ImageStage"
                  MinHeight="300"
                  ClipToBounds="True"
                  SizeChanged="OnImageStageSizeChanged">
                <Canvas x:Name="ImageCanvas"
                        Background="#FF0C141C"
                        ClipToBounds="True"
                        PreviewMouseMove="OnImageCanvasPreviewMouseMove"
                        PreviewMouseLeftButtonUp="OnImageCanvasPreviewMouseLeftButtonUp">
                    <Image x:Name="PreviewImage"
                           Stretch="Fill"
                           SnapsToDevicePixels="True" />
                    <Path x:Name="CropShade"
                          Fill="#99000000"
                          IsHitTestVisible="False" />
                    <Border x:Name="CropFrame"
                            Background="Transparent"
                            BorderBrush="#F2FFFFFF"
                            BorderThickness="2"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="OnCropFrameMouseLeftButtonDown">
                        <Grid>
                            <Grid IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="1"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="0,1,0,1" />
                                <Border Grid.Column="1"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1,0,1,0" />
                            </Grid>
                            <Border x:Name="TopLeftHandle"
                                    Width="14"
                                    Height="14"
                                    Margin="-7,-7,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#FFFFFFFF"
                                    BorderBrush="#FF2176E8"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Cursor="SizeNWSE"
                                    Tag="TopLeft"
                                    MouseLeftButtonDown="OnCropHandleMouseLeftButtonDown" />
                            <Border x:Name="TopRightHandle"
                                    Width="14"
                                    Height="14"
                                    Margin="0,-7,-7,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#FFFFFFFF"
                                    BorderBrush="#FF2176E8"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Cursor="SizeNESW"
                                    Tag="TopRight"
                                    MouseLeftButtonDown="OnCropHandleMouseLeftButtonDown" />
                            <Border x:Name="BottomLeftHandle"
                                    Width="14"
                                    Height="14"
                                    Margin="-7,0,0,-7"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="#FFFFFFFF"
                                    BorderBrush="#FF2176E8"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Cursor="SizeNESW"
                                    Tag="BottomLeft"
                                    MouseLeftButtonDown="OnCropHandleMouseLeftButtonDown" />
                            <Border x:Name="BottomRightHandle"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,-7,-7"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#FFFFFFFF"
                                    BorderBrush="#FF2176E8"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Cursor="SizeNWSE"
                                    Tag="BottomRight"
                                    MouseLeftButtonDown="OnCropHandleMouseLeftButtonDown" />
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CropSizeText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SettingsMutedBrush}"
                       FontSize="13" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Content="取消"
                        MinWidth="88"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button Content="使用此裁切"
                        MinWidth="120"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
