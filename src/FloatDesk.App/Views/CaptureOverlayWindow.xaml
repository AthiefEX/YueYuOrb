<Window x:Class="FloatDesk.App.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Black"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseRightButtonDown="OnMouseRightButtonDown">
    <Grid>
        <Image x:Name="FrozenImage"
               Stretch="Fill"
               SnapsToDevicePixels="True" />
        <Rectangle Fill="#66000000"
                   IsHitTestVisible="False" />
        <Border x:Name="SelectionBorder"
                BorderBrush="#FFFF3B30"
                BorderThickness="2"
                Background="#10FFFFFF"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        <Border Background="#D91D2623"
                CornerRadius="10"
                Padding="14,9"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                IsHitTestVisible="False">
            <TextBlock Foreground="White"
                       Text="拖动框选 · Enter 确认 · 方向键微调 · Esc/右键取消" />
        </Border>
        <TextBlock x:Name="SizeText"
                   Foreground="White"
                   Background="#D91D2623"
                   Padding="8,4"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,20"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />
    </Grid>
</Window>
