<UserControl x:Class="FloatDesk.App.Views.ColorPickerField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="250" Focusable="False">
    <UserControl.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H12 V12 H0 Z" />
                    <GeometryDrawing Brush="#BBBBBB" Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="SwatchButton" Margin="0,0,8,0" Padding="3" MinHeight="32"
                Click="OpenPicker" AutomationProperties.Name="选择颜色" ToolTip="选择颜色">
            <Border Background="{StaticResource CheckerBrush}" Width="26" Height="22">
                <Border x:Name="SwatchPreview" />
            </Border>
        </Button>
        <TextBox x:Name="HexTextBox" Grid.Column="1" VerticalContentAlignment="Center"
                 MinHeight="32" TextChanged="HexTextChanged"
                 Style="{DynamicResource SettingsTextBoxStyle}"
                 AutomationProperties.Name="十六进制颜色" ToolTip="#RRGGBB 或 #AARRGGBB" />
        <Popup x:Name="PickerPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SwatchButton}"
               StaysOpen="False" AllowsTransparency="True" Opened="PickerOpened" Closed="PickerClosed">
            <Border x:Name="PopupCard" Width="280" Padding="12" CornerRadius="10" BorderThickness="1"
                    PreviewKeyDown="PopupKeyDown">
                <StackPanel>
                    <TextBlock Text="选择颜色" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid x:Name="SaturationValuePanel" Height="136" ClipToBounds="True"
                          MouseLeftButtonDown="PanelMouseDown" MouseMove="PanelMouseMove"
                          MouseLeftButtonUp="PanelMouseUp" SizeChanged="PanelSizeChanged"
                          AutomationProperties.Name="饱和度和明度色板">
                        <Border x:Name="HueSurface" />
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SelectionMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Color="Black" /></Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                    <TextBlock Text="色相" Margin="0,8,0,0" />
                    <Slider x:Name="HueSlider" Minimum="0" Maximum="360" SmallChange="1" LargeChange="30"
                            ValueChanged="ChannelChanged" AutomationProperties.Name="色相（0 到 360）" />
                    <TextBlock Text="饱和度" />
                    <Slider x:Name="SaturationSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                            ValueChanged="ChannelChanged" AutomationProperties.Name="饱和度" />
                    <TextBlock Text="明度" />
                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                            ValueChanged="ChannelChanged" AutomationProperties.Name="明度" />
                    <TextBlock Text="不透明度" />
                    <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ChannelChanged"
                            AutomationProperties.Name="不透明度（0 到 255）" />
                    <Border Background="{StaticResource CheckerBrush}" Height="26" Margin="0,6">
                        <Border x:Name="PopupPreview" AutomationProperties.Name="当前颜色预览" />
                    </Border>
                    <UniformGrid x:Name="PresetPanel" Columns="8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
