<Window x:Class="FloatDesk.App.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720"
        Height="520"
        MinWidth="460"
        MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Title="FloatDesk 记事本">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox"
                     TextChanged="OnSearchTextChanged"
                     ToolTip="搜索标题和正文"
                     Margin="0,0,0,8" />
            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,8">
                <Button Content="新建"
                        Click="OnNewClick"
                        Margin="0,0,4,0"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button x:Name="RecycleButton"
                        Content="回收站"
                        Click="OnRecycleClick"
                        Margin="4,0,0,0" />
            </UniformGrid>
            <ListBox x:Name="NotesList"
                     Grid.Row="2"
                     SelectionChanged="OnNoteSelectionChanged"
                     DisplayMemberPath="Title" />
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="TitleBox"
                     FontSize="20"
                     FontWeight="SemiBold"
                     TextChanged="OnEditorChanged"
                     Margin="0,0,0,8" />
            <TextBox x:Name="BodyBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     TextChanged="OnEditorChanged" />
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="SaveStatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedInkBrush}"
                           Text="选择或新建一条笔记。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="重试保存"
                            Click="OnRetrySaveClick"
                            Margin="0,0,8,0" />
                    <Button Content="导出 TXT"
                            Click="OnExportClick"
                            Margin="0,0,8,0" />
                    <Button x:Name="DeleteButton"
                            Content="移到回收站"
                            Click="OnDeleteClick"
                            Margin="0,0,8,0" />
                    <Button Content="立即保存"
                            Click="OnSaveNowClick"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
