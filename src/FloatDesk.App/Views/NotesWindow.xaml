<Window x:Class="FloatDesk.App.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="920"
        Height="680"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsWindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="月语悬浮球记事本">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YueYuOrb;component/Resources/SettingsWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ToolWindowShellStyle}">
        <Grid Background="{DynamicResource ToolWindowContentBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />

                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Grid x:Name="NotesTitleBar"
                  Grid.Row="0"
                  Style="{StaticResource ToolWindowTitleBarStyle}"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="8"
                            Margin="0,0,9,0"
                            Background="{DynamicResource SettingsAccentBrush}">
                        <TextBlock Text="月"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="月语悬浮球记事本"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsInkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="NotesMinimizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化记事本">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="12"
                                   Text="&#xE921;" />
                    </Button>
                    <Button x:Name="NotesMaximizeRestoreButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMaximizeRestoreClick"
                            AutomationProperties.Name="最大化记事本">
                        <TextBlock x:Name="NotesMaximizeGlyph"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="12"
                                   Text="&#xE922;" />
                    </Button>
                    <Button x:Name="NotesCloseButton"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="OnCloseClick"
                            AutomationProperties.Name="关闭记事本">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="12"
                                   Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>



            <Grid Grid.Row="1" Margin="14,10,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ToolWindowSectionStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="笔记库"
                                       Style="{StaticResource SettingsSectionTitleStyle}" />
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SettingsAccentSoftBrush}"
                                    CornerRadius="10"
                                    Padding="9,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="LOCAL"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SettingsAccentBrush}" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,12,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox"
                                     MinHeight="38"
                                     Padding="12,7"
                                     TextChanged="OnSearchTextChanged"
                                     ToolTip="搜索标题和正文"
                                     Style="{StaticResource SettingsTextBoxStyle}" />
                            <Button Grid.Column="2"
                                    Content="新建笔记"
                                    ToolTip="新建笔记"
                                    AutomationProperties.Name="新建笔记"
                                    Click="OnNewClick"
                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                        </Grid>
                        <ListBox x:Name="NotesList"
                                 Grid.Row="2"
                                 SelectionChanged="OnNoteSelectionChanged"
                                 DisplayMemberPath="Title"
                                 Style="{StaticResource ToolWindowListBoxStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource ToolWindowSectionStyle}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="正在编辑"
                                       Style="{StaticResource SettingsSectionTitleStyle}" />
                            <Button x:Name="RecycleButton"
                                    Content="回收站"
                                    HorizontalAlignment="Right"
                                    Click="OnRecycleClick"
                                    Style="{StaticResource ToolbarButtonStyle}" />
                        </Grid>
                        <TextBox x:Name="TitleBox"
                                 Grid.Row="1"
                                 Margin="0,12,0,10"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 TextChanged="OnEditorChanged"
                                 Style="{StaticResource SettingsTextBoxStyle}" />
                        <TextBox x:Name="BodyBox"
                                 Grid.Row="2"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 TextChanged="OnEditorChanged"
                                 Style="{StaticResource ToolWindowEditorStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="14,0,14,8"
                    Background="{DynamicResource SettingsCardSubtleBrush}"
                    BorderBrush="{DynamicResource SettingsLineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,0">
                <Grid>
                    <TextBlock x:Name="SaveStatusText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SettingsMutedBrush}"
                               Text="选择或新建一条笔记。" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="重试保存"
                                Click="OnRetrySaveClick"
                                Margin="0,0,7,0"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="导出 TXT"
                                Click="OnExportClick"
                                Margin="0,0,7,0"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button x:Name="DeleteButton"
                                Content="移到回收站"
                                Click="OnDeleteClick"
                                Margin="0,0,7,0"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="立即保存"
                                Click="OnSaveNowClick"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
