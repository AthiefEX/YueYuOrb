<UserControl x:Class="FloatDesk.App.Views.CrystalOrbSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             Focusable="False"
             UseLayoutRounding="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">
            <Canvas.Clip>
                <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
            </Canvas.Clip>

            <!-- Every surface uses the same 100-unit sphere; nothing extends outside it. -->
            <Ellipse Width="100" Height="100">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.43,0.36" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#00BCE4F5" Offset="0" />
                        <GradientStop Color="#00BCE4F5" Offset="0.62" />
                        <GradientStop Color="#100D2942" Offset="0.81" />
                        <GradientStop Color="#4612273D" Offset="0.92" />
                        <GradientStop Color="#8ADAF2FF" Offset="0.97" />
                        <GradientStop Color="#55243548" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Left="0.7" Canvas.Top="0.7" Width="98.6" Height="98.6" StrokeThickness="1.4">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E8FFFFFF" Offset="0" />
                        <GradientStop Color="#C4E9F6FF" Offset="0.22" />
                        <GradientStop Color="#48627E96" Offset="0.47" />
                        <GradientStop Color="#B6C4EBFF" Offset="0.72" />
                        <GradientStop Color="#EEF4FDFF" Offset="0.9" />
                        <GradientStop Color="#667C9DB0" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>
            <Ellipse Canvas.Left="2.4" Canvas.Top="2.4" Width="95.2" Height="95.2" StrokeThickness="0.65">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                        <GradientStop Color="#AAF9FFFF" Offset="0" />
                        <GradientStop Color="#00E5F4FF" Offset="0.4" />
                        <GradientStop Color="#15334B65" Offset="0.65" />
                        <GradientStop Color="#9AE3F7FF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <Path Data="M 9,33 C 15,15 31,5 49,5 C 34,9 23,18 18,32 C 16,38 11,40 9,33 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                        <GradientStop Color="#DCFFFFFF" Offset="0" />
                        <GradientStop Color="#74FFFFFF" Offset="0.32" />
                        <GradientStop Color="#06FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path Data="M 22,18 C 34,10 49,9 60,13 C 65,15 57,20 45,20 C 32,20 23,24 19,28 C 18,25 19,21 22,18 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                        <GradientStop Color="#66FFFFFF" Offset="0" />
                        <GradientStop Color="#2AFFFFFF" Offset="0.48" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <Path Data="M 5.1,43 C 7,24 21,9 39,5.3" StrokeThickness="0.85" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                        <GradientStop Color="#06FFF6DD" Offset="0" />
                        <GradientStop Color="#DDFDF5DF" Offset="0.48" />
                        <GradientStop Color="#20FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
            <Path Data="M 92,32 C 98,50 94,70 82,83" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00B6E5FF" Offset="0" />
                        <GradientStop Color="#A6D8F3FF" Offset="0.55" />
                        <GradientStop Color="#14FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
            <Path Data="M 32,91 C 47,98 66,95 78,86 C 68,96 47,100 32,94 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00D1EFFF" Offset="0" />
                        <GradientStop Color="#B4E5F7FF" Offset="0.55" />
                        <GradientStop Color="#00D1EFFF" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
