<Window x:Class="FloatDesk.App.Views.TranslationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Width="420" MinWidth="280" MaxWidth="720" MaxHeight="500"
        SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        Focusable="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        automation:AutomationProperties.Name="文字结果" Title="文字结果">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YueYuOrb;component/Resources/SettingsWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="OverlayCard" Background="{DynamicResource SettingsCardBrush}"
            BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="1"
            CornerRadius="10" Padding="1">
        <Grid>
            <Grid x:Name="CardBackdrop" IsHitTestVisible="False" Visibility="Collapsed" />
            <Grid x:Name="TransitionLayer">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="TransitionTranslate" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="TitleBar" Grid.Row="0" Padding="10,4,4,0"
                        Background="Transparent" Cursor="SizeAll" ToolTip="拖动移动"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
                        MouseMove="OnTitleBarMouseMove" MouseLeftButtonUp="OnTitleBarMouseLeftButtonUp"
                        LostMouseCapture="OnTitleBarLostMouseCapture">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SettingsMutedBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Cursor="Arrow">
                            <Button x:Name="TranslateExtractedButton" Content="翻译"
                                    Height="26" MinHeight="0" Padding="8,0" Margin="0,0,6,0"
                                    Visibility="Collapsed" Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnTranslateExtractedClick" ToolTip="翻译提取的文字"
                                    automation:AutomationProperties.Name="翻译提取的文字" />
                            <Button x:Name="CopyButton" Width="28" Height="26" MinHeight="0"
                                    Padding="0" Margin="0,0,2,0" IsEnabled="False"
                                    Style="{StaticResource ToolbarIconButtonStyle}" Click="OnCopyClick"
                                    ToolTip="复制全部文字" automation:AutomationProperties.Name="复制全部文字">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource SettingsIconFont}" FontSize="12" />
                            </Button>
                            <Button x:Name="CloseButton" Width="28" Height="26" MinHeight="0"
                                    Padding="0" Style="{StaticResource ToolbarIconButtonStyle}"
                                    Click="OnCloseClick" ToolTip="关闭"
                                    automation:AutomationProperties.Name="关闭结果">
                                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource SettingsIconFont}" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="14,6,14,12">
                    <TextBlock x:Name="MetadataTextBlock" Visibility="Collapsed" />
                    <Border x:Name="OriginalPanel" Visibility="Collapsed">
                        <TextBlock x:Name="OriginalTextBlock" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="TranslatedPanel" Visibility="Collapsed">
                        <TextBox x:Name="TranslatedTextBlock" Style="{x:Null}"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 MinHeight="0" MaxHeight="360"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontSize="20" FontWeight="Normal"
                                 Foreground="{DynamicResource SettingsInkBrush}"
                                 PreviewMouseLeftButtonDown="OnResultPreviewMouseLeftButtonDown"
                                 automation:AutomationProperties.LiveSetting="Polite"
                                 automation:AutomationProperties.Name="可选择和复制的结果文字" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Margin="14,0,14,10"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SettingsMutedBrush}"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="处理状态" />
                <Border x:Name="SubtitleControlBar" Grid.Row="3" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PauseResumeButton" Content="暂停" Click="OnPauseResumeClick" />
                        <Button x:Name="ReselectButton" Content="重新选择" Click="OnReselectClick" />
                        <Button x:Name="StopSubtitleButton" Content="停止" Click="OnStopSubtitleClick" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="SubtitleSurface" Visibility="Collapsed"
                  Background="Transparent" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SubtitleNoticeTextBlock" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="12" Visibility="Collapsed"
                               Foreground="{DynamicResource SettingsMutedBrush}"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="字幕提示" />
                    <TextBlock x:Name="SubtitleTranslationTextBlock" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsInkBrush}"
                               TextOptions.TextFormattingMode="Display"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="字幕译文">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                              Opacity="0.88" Color="#FF001018" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
