<Window x:Class="FloatDesk.App.Views.TranslationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Width="480"
        MinWidth="340"
        MaxWidth="720"
        MaxHeight="500"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        automation:AutomationProperties.Name="月语翻译浮层"
        Title="月语翻译">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YueYuOrb;component/Resources/SettingsWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="OverlayCard"
            Background="{DynamicResource SettingsCardBrush}"
            BorderBrush="{DynamicResource SettingsAccentOutlineBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="1"
            automation:AutomationProperties.Name="翻译结果卡片">
        <Grid>
            <Grid x:Name="CardBackdrop"
                  IsHitTestVisible="False">
                <Border Background="{DynamicResource SettingsHeroBrush}"
                        CornerRadius="21"
                        Opacity="0.68" />
                <Border Background="{DynamicResource SettingsNavBarBrush}"
                        CornerRadius="21"
                        Opacity="0.32" />
            </Grid>

            <Grid x:Name="TransitionLayer">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="TransitionTranslate" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar"
                        Grid.Row="0"
                        Padding="18,14,12,10"
                        Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
                        MouseMove="OnTitleBarMouseMove"
                        MouseLeftButtonUp="OnTitleBarMouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="34"
                                Height="34"
                                Margin="0,0,10,0"
                                CornerRadius="11"
                                Background="{DynamicResource SettingsAccentBrush}">
                            <TextBlock Text="译"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       automation:AutomationProperties.Name="翻译" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="月语翻译"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SettingsInkBrush}" />
                            <TextBlock x:Name="MetadataTextBlock"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SettingsMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       automation:AutomationProperties.Name="翻译语言和提供方" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="CopyButton"
                                    Margin="0,0,6,0"
                                    Padding="10,6"
                                    IsEnabled="False"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnCopyClick"
                                    ToolTip="复制译文"
                                    automation:AutomationProperties.Name="复制译文">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,5,0"
                                               FontFamily="{StaticResource SettingsIconFont}"
                                               FontSize="12"
                                               Text="&#xE8C8;" />
                                    <TextBlock Text="复制" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CloseButton"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    Click="OnCloseClick"
                                    ToolTip="关闭翻译浮层"
                                    automation:AutomationProperties.Name="关闭翻译浮层">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                           FontSize="12"
                                           Text="&#xE8BB;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Margin="18,0,18,0"
                              MaxHeight="280"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="OriginalPanel"
                                Margin="0,0,0,8"
                                Padding="12,9"
                                CornerRadius="12"
                                Background="{DynamicResource SettingsFieldBrush}"
                                BorderBrush="{DynamicResource SettingsLineBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="原文"
                                           Margin="0,0,0,5"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SettingsMutedBrush}"
                                           automation:AutomationProperties.Name="原文标签" />
                                <TextBlock x:Name="OriginalTextBlock"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SettingsInkBrush}"
                                           automation:AutomationProperties.Name="原文" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="TranslatedPanel"
                                Padding="15,13"
                                CornerRadius="14"
                                Background="{DynamicResource SettingsAccentPaleBrush}"
                                BorderBrush="{DynamicResource SettingsAccentOutlineBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="译文"
                                           Margin="0,0,0,6"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SettingsAccentBrush}"
                                           automation:AutomationProperties.Name="译文标签" />
                                <TextBlock x:Name="TranslatedTextBlock"
                                           MinHeight="22"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           LineHeight="28"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SettingsInkBrush}"
                                           automation:AutomationProperties.LiveSetting="Polite"
                                           automation:AutomationProperties.Name="译文" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="18,10,18,14"
                        Padding="11,7"
                        CornerRadius="10"
                        Background="{DynamicResource SettingsAccentSoftBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource SettingsAccentBrush}" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Grid.Column="1"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource SettingsMutedBrush}"
                                   automation:AutomationProperties.LiveSetting="Polite"
                                   automation:AutomationProperties.Name="翻译状态" />
                    </Grid>
                </Border>

                <Border x:Name="SubtitleControlBar"
                        Grid.Row="3"
                        Margin="18,0,18,16"
                        Padding="10"
                        CornerRadius="13"
                        Background="{DynamicResource SettingsCardSubtleBrush}"
                        BorderBrush="{DynamicResource SettingsLineBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock Margin="3,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="字幕控制"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SettingsMutedBrush}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="PauseResumeButton"
                                    Content="暂停"
                                    Margin="0,0,6,0"
                                    Padding="12,6"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnPauseResumeClick"
                                    automation:AutomationProperties.Name="暂停字幕翻译" />
                            <Button x:Name="ReselectButton"
                                    Content="重新选择"
                                    Margin="0,0,6,0"
                                    Padding="12,6"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnReselectClick"
                                    automation:AutomationProperties.Name="重新选择字幕区域" />
                            <Button x:Name="StopSubtitleButton"
                                    Content="停止"
                                    Padding="12,6"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnStopSubtitleClick"
                                    automation:AutomationProperties.Name="停止字幕翻译" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SubtitleSurface"
                  Visibility="Collapsed"
                  Background="Transparent"
                  IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SubtitleNoticeTextBlock"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource SettingsMutedBrush}"
                               Visibility="Collapsed"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="字幕提示" />
                    <TextBlock x:Name="SubtitleTranslationTextBlock"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsInkBrush}"
                               TextOptions.TextFormattingMode="Display"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="字幕译文">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.88"
                                              Color="#FF001018" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
