<Window x:Class="FloatDesk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="1160"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Title="月语悬浮球设置"
        Background="{DynamicResource SettingsWindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YueYuOrb;component/Resources/SettingsWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsShellStyle" TargetType="{x:Type Border}">
                <Setter Property="Margin" Value="7" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{DynamicResource SettingsShellBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsAccentOutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ClipToBounds" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="SettingsRoot" Style="{StaticResource SettingsShellStyle}">
        <Grid Background="{DynamicResource SettingsShellBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="88" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Grid x:Name="SettingsTitleBar"
                  Grid.Row="0"
                  Background="{DynamicResource ToolWindowTitleBarBrush}"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="8"
                            Background="{DynamicResource SettingsAccentBrush}"
                            Margin="0,0,9,0">
                        <TextBlock Text="月"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="月语悬浮球设置"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsInkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeSettingsButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化设置窗口">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="12" Text="&#xE921;" />
                    </Button>
                    <Button x:Name="MaximizeSettingsButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMaximizeClick"
                            AutomationProperties.Name="最大化或还原设置窗口">
                        <TextBlock x:Name="MaximizeButtonGlyph"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button x:Name="CloseSettingsButton"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="OnCloseSettingsClick"
                            AutomationProperties.Name="关闭设置窗口">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="12" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Grid.RowSpan="2"
                    Background="{DynamicResource SettingsHeroBrush}"
                    CornerRadius="0,0,22,22"
                    ClipToBounds="True">
                <Grid>
                    <Ellipse Width="310"
                             Height="130"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,-42,-38,0"
                             Fill="{DynamicResource SettingsCardBrush}"
                             Opacity="0.58" />
                    <Ellipse Width="230"
                             Height="110"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="40,0,0,-70"
                             Fill="{DynamicResource SettingsAccentOutlineBrush}"
                             Opacity="0.34" />
                    <Viewbox Stretch="Fill" Opacity="0.22" IsHitTestVisible="False">
                        <Canvas Width="1160" Height="148">
                            <Path Fill="{DynamicResource SettingsAccentOutlineBrush}" Data="M0,118 L116,49 L198,97 L303,31 L414,106 L534,66 L654,112 L775,42 L904,104 L1029,63 L1160,117 L1160,148 L0,148 Z" />
                            <Path Fill="{DynamicResource SettingsAccentSoftBrush}" Data="M0,128 L151,81 L278,116 L431,71 L581,124 L742,83 L910,121 L1082,72 L1160,97 L1160,148 L0,148 Z" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="34,15,34,8" Panel.ZIndex="2">
                <StackPanel>
                    <TextBlock Text="月语悬浮球设置"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsInkBrush}" />
                    <TextBlock Text="调整悬浮球、输入法、网页、笔记与截图"
                               Margin="1,3,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SettingsMutedBrush}" />
                </StackPanel>
                <Border Style="{StaticResource SettingsPillStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,3,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource SettingsAccentBrush}"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="本地保存 · 普通权限"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SettingsAccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl x:Name="SettingsTabControl"
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Style="{StaticResource SettingsTabControlStyle}"
                        ItemContainerStyle="{StaticResource NavigationTabItemStyle}"
                        SelectionChanged="OnSettingsTabSelectionChanged">
                    <TabItem Style="{StaticResource NavigationTabItemStyle}" AutomationProperties.Name="常规">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE80F;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="常规" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,16,28,24" MaxWidth="1080" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                                <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE7B8;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="启动与外观" />
                                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="设置软件启动方式与界面外观" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Margin="0,16,0,0" Padding="16,2">
                                            <StackPanel>
                                                <Border Style="{StaticResource SettingsRowStyle}">
                                                    <CheckBox Content="随 Windows 登录启动"
                                                              IsChecked="{Binding StartWithWindows}"
                                                              Style="{StaticResource ToggleSwitchStyle}" />
                                                </Border>
                                                <Grid MinHeight="58" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="250" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="应用主题" Style="{StaticResource SettingsLabelStyle}" />
                                                        <TextBlock Text="选择月语悬浮球的整体外观" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1"
                                                              SelectedIndex="{Binding ThemeIndex}"
                                                              Style="{StaticResource SettingsComboBoxStyle}"
                                                              VerticalAlignment="Center">
                                                        <ComboBoxItem Content="跟随系统" />
                                                        <ComboBoxItem Content="浅色" />
                                                        <ComboBoxItem Content="深色" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                                <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE765;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="快捷键" />
                                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="设置常用功能的快捷键，提升操作效率" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Margin="0,16,0,0" Padding="16,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                </Grid.RowDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="快捷面板" Style="{StaticResource SettingsLabelStyle}" />
                                                    <TextBlock Text="打开月语悬浮球快捷面板" Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding PanelHotkey}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                    <TextBlock Text="框选截图" Style="{StaticResource SettingsLabelStyle}" />
                                                    <TextBlock Text="启动框选截图功能" Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RegionCaptureHotkey}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                                    <TextBlock Text="暂停输入规则" Style="{StaticResource SettingsLabelStyle}" />
                                                    <TextBlock Text="临时暂停输入法相关规则" Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PauseHotkey}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                                                    <TextBlock Text="翻译选中" Style="{StaticResource SettingsLabelStyle}" />
                                                    <TextBlock Text="翻译当前应用中的选中文字" Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <TextBox x:Name="TranslationSelectionHotkeyTextBox" Grid.Row="3" Grid.Column="1" Text="{Binding TranslationSelectionHotkey}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" AutomationProperties.Name="翻译选中快捷键" />
                                                <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <StackPanel Grid.Row="4" VerticalAlignment="Center">
                                                    <TextBlock Text="框选翻译" Style="{StaticResource SettingsLabelStyle}" />
                                                    <TextBlock Text="框选屏幕区域并翻译识别文字" Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <TextBox x:Name="TranslationRegionHotkeyTextBox" Grid.Row="4" Grid.Column="1" Text="{Binding TranslationRegionHotkey}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" AutomationProperties.Name="框选翻译快捷键" />
                                                <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <StackPanel Grid.Row="5" VerticalAlignment="Center">
                                                    <TextBlock Text="字幕翻译" Style="{StaticResource SettingsLabelStyle}" />
                                                    <TextBlock Text="开始或停止固定区域字幕翻译" Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <TextBox x:Name="SubtitlesHotkeyTextBox" Grid.Row="5" Grid.Column="1" Text="{Binding SubtitlesHotkey}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" AutomationProperties.Name="字幕翻译快捷键" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsToolbarStyle}" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="快捷键格式示例：Ctrl+Alt+Space、Ctrl+Shift+F8。启动时冲突会自动尝试备用组合并提示；修改时冲突会保留原绑定。"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,16,0" />
                                                <Button Grid.Column="1" Content="恢复默认偏好" Click="OnResetPreferencesClick" Style="{StaticResource ActionButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="配置文件" Style="{StaticResource SettingsSectionTitleStyle}" />
                                            <TextBlock Text="导出用于备份，或从月语悬浮球 JSON 配置文件恢复设置。导入不会运行任何应用。"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="导出设置" Click="OnExportSettingsClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                            <Button Content="导入设置" Click="OnImportSettingsClick" Style="{StaticResource ActionButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Style="{StaticResource NavigationTabItemStyle}" AutomationProperties.Name="悬浮球">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE707;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="悬浮球" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,16,28,24" MaxWidth="1080" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                                <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE707;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="外观与尺寸" />
                                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="调整悬浮球大小、透明度与图片呈现方式" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Margin="0,16,0,0" Padding="16,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="悬浮球尺寸" Style="{StaticResource SettingsLabelStyle}" />
                                                <Slider Grid.Column="1" Minimum="32" Maximum="128" TickFrequency="4" IsSnapToTickEnabled="True" Value="{Binding OrbSizeDip}" Style="{StaticResource SettingsSliderStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding OrbSizeDip, StringFormat={}{0} px}" Style="{StaticResource SettingsCaptionStyle}" />
                                                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="1" Text="不透明度" Style="{StaticResource SettingsLabelStyle}" />
                                                <Slider Grid.Row="1" Grid.Column="1" Minimum="30" Maximum="100" Value="{Binding OrbOpacityPercent}" Style="{StaticResource SettingsSliderStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OrbOpacityPercent, StringFormat={}{0:0}%}" Style="{StaticResource SettingsCaptionStyle}" />
                                                <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="2" Text="图片轮廓" Style="{StaticResource SettingsLabelStyle}" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding ImageShapeIndex}" Style="{StaticResource SettingsComboBoxStyle}" VerticalAlignment="Center">
                                                    <ComboBoxItem Content="圆形裁切" />
                                                    <ComboBoxItem Content="保留透明轮廓" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="更换悬浮球图片" Click="OnChooseOrbImageClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                            <Button Content="恢复默认图片" Click="OnResetOrbImageClick" Style="{StaticResource ActionButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="时间与位置" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="控制悬浮球上的时钟与桌面位置行为。" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,3,0,12" />
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Padding="16,4">
                                            <StackPanel>
                                                <CheckBox Content="显示时间" IsChecked="{Binding ShowClock}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                                <CheckBox Content="显示秒" IsChecked="{Binding ShowSeconds}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                                <CheckBox Content="使用 24 小时制" IsChecked="{Binding Clock24Hour}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                                <CheckBox Content="拖动后吸附屏幕边缘" IsChecked="{Binding SnapToEdge}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                                <CheckBox Content="锁定当前位置" IsChecked="{Binding PositionLocked}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="窗口层级" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="设置悬浮球在普通窗口与全屏应用中的显示方式。" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,3,0,12" />
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Padding="16,8">
                                            <StackPanel>
                                                <CheckBox Content="悬浮球始终位于普通窗口上方" IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5,0,12" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="全屏应用期间" Style="{StaticResource SettingsLabelStyle}" />
                                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding FullscreenPolicyIndex}" Style="{StaticResource SettingsComboBoxStyle}">
                                                        <ComboBoxItem Content="跟随普通置顶" />
                                                        <ComboBoxItem Content="自动隐藏" />
                                                        <ComboBoxItem Content="尽力保持置顶" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="独占全屏、受保护界面及部分游戏覆盖层不保证显示。"
                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                   Margin="2,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Style="{StaticResource NavigationTabItemStyle}" AutomationProperties.Name="快捷应用">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE71D;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="快捷应用" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid x:Name="LauncherDropSurface"
                              Margin="28,16,28,24"
                              AllowDrop="True"
                              DragOver="OnLauncherDragOver"
                              DragLeave="OnLauncherDragLeave"
                              Drop="OnLauncherDrop">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="20,16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Border Style="{StaticResource SettingsIconTileStyle}">
                                            <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE71D;" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="快捷应用" Style="{StaticResource SettingsSectionTitleStyle}" />
                                            <TextBlock Text="可直接拖入 exe 或快捷方式到此页面添加应用。未加入轮盘的应用保留在底部应用坞，移出轮盘不会删除应用。"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="添加 exe" Click="OnAddExeClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                        <Button Content="添加快捷方式" Click="OnAddShortcutClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                        <Button Content="添加文件夹" Click="OnAddFolderClick" Style="{StaticResource ActionButtonStyle}" />
                                    </WrapPanel>
                                </Grid>
