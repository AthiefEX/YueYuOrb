                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="API 密钥" Style="{StaticResource SettingsLabelStyle}" />
                                                            <PasswordBox x:Name="TranslationApiKeyBox"
                                                                         Grid.Column="1"
                                                                         PasswordChanged="OnTranslationApiKeyPasswordChanged"
                                                                         Style="{StaticResource SettingsPasswordBoxStyle}"
                                                                         AutomationProperties.Name="翻译 API 密钥"
                                                                         VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Grid Margin="180,7,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="TranslationKeyStatusText"
                                                                       Text="正在读取密钥状态…"
                                                                       Style="{StaticResource SettingsCaptionStyle}"
                                                                       AutomationProperties.Name="翻译 API 密钥状态"
                                                                       AutomationProperties.LiveSetting="Polite" />
                                                            <CheckBox x:Name="ClearSavedTranslationKeyCheckBox"
                                                                      Grid.Column="1"
                                                                      Content="清除已保存密钥"
                                                                      IsChecked="{Binding ClearSavedTranslationKey}"
                                                                      IsEnabled="{Binding HasSavedTranslationKey}"
                                                                      Checked="OnClearSavedTranslationKeyChanged"
                                                                      Unchecked="OnClearSavedTranslationKeyChanged"
                                                                      Style="{StaticResource SettingsCheckBoxStyle}"
                                                                      AutomationProperties.Name="清除已保存翻译 API 密钥"
                                                                      Margin="12,0,0,0" />
                                                        </Grid>
                                                        <TextBlock Text="密码框只保留本次编辑的临时值；留空不会覆盖已保存密钥，输入新密钥后点击“应用”才会加密保存。"
                                                                   Style="{StaticResource SettingsCaptionStyle}"
                                                                   Margin="180,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="TranslationModelField" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0">
                                                    <Grid Height="58">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="模型" Style="{StaticResource SettingsLabelStyle}" />
                                                        <TextBox x:Name="TranslationModelTextBox"
                                                                 Grid.Column="1"
                                                                 Text="{Binding TranslationModel}"
                                                                 Style="{StaticResource SettingsTextBoxStyle}"
                                                                 AutomationProperties.Name="翻译模型"
                                                                 VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="TranslationAzureRegionField" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0">
                                                    <Grid Height="58">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Azure 区域" Style="{StaticResource SettingsLabelStyle}" />
                                                        <TextBox x:Name="TranslationAzureRegionTextBox"
                                                                 Grid.Column="1"
                                                                 Text="{Binding TranslationAzureRegion}"
                                                                 Style="{StaticResource SettingsTextBoxStyle}"
                                                                 AutomationProperties.Name="Azure 翻译区域"
                                                                 VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <Border BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <Grid Height="58">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="OCR 语言" Style="{StaticResource SettingsLabelStyle}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <ComboBox x:Name="TranslationOcrLanguageComboBox"
                                                                  ItemsSource="{Binding OcrLanguages}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  SelectedIndex="{Binding TranslationOcrLanguageIndex}"
                                                                  Style="{StaticResource SettingsComboBoxStyle}"
                                                                  AutomationProperties.Name="翻译 OCR 语言" />
                                                        <TextBlock Text="仅列出 Windows 已安装的 OCR 语言，可在系统语言设置中安装语言包。"
                                                                   Style="{StaticResource SettingsCaptionStyle}"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TranslationProviderHintText"
                                                   Text="MyMemory 是无需密钥的公共免费服务。"
                                                   Style="{StaticResource SettingsCaptionStyle}"
                                                   Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="字幕翻译" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="固定区域只在本地采样与识别；译文以透明、区域锚定的纯文字贴合字幕显示，未变化的画面不会重复发送请求。"
                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                   Margin="0,3,0,12" />
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Padding="16,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="画面检测间隔（100–1500 ms，150 ms 适合实时字幕）" Style="{StaticResource SettingsLabelStyle}" />
                                                <TextBox x:Name="SubtitleRefreshIntervalTextBox"
                                                         Grid.Column="1"
                                                         Text="{Binding SubtitleRefreshIntervalMs}"
                                                         Style="{StaticResource SettingsTextBoxStyle}"
                                                         AutomationProperties.Name="字幕翻译采样间隔"
                                                         VerticalAlignment="Center" />
                                                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="1" Text="显示位置" Style="{StaticResource SettingsLabelStyle}" />
                                                <ComboBox x:Name="SubtitleAttachmentComboBox"
                                                         Grid.Row="1"
                                                         Grid.Column="1"
                                                         SelectedIndex="{Binding SubtitleAttachmentIndex}"
                                                         Style="{StaticResource SettingsComboBoxStyle}"
                                                         AutomationProperties.Name="字幕翻译显示位置"
                                                         VerticalAlignment="Center">
                                                    <ComboBoxItem Content="自动" />
                                                    <ComboBoxItem Content="字幕上方" />
                                                    <ComboBoxItem Content="字幕下方" />
                                                </ComboBox>
                                                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="2" Text="文字不透明度（60–100%）" Style="{StaticResource SettingsLabelStyle}" />
                                                <TextBox x:Name="SubtitleOverlayOpacityTextBox"
                                                         Grid.Row="2"
                                                         Grid.Column="1"
                                                         Text="{Binding SubtitleOverlayOpacityPercent}"
                                                         Style="{StaticResource SettingsTextBoxStyle}"
                                                         AutomationProperties.Name="字幕翻译文字不透明度"
                                                         VerticalAlignment="Center" />
                                                <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="3" Text="字号（14–36 DIP）" Style="{StaticResource SettingsLabelStyle}" />
                                                <TextBox x:Name="SubtitleFontSizeTextBox"
                                                         Grid.Row="3"
                                                         Grid.Column="1"
                                                         Text="{Binding SubtitleFontSizeDip}"
                                                         Style="{StaticResource SettingsTextBoxStyle}"
                                                         AutomationProperties.Name="字幕翻译字号"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="连接检查" Style="{StaticResource SettingsSectionTitleStyle}" />
                                                <TextBlock Text="使用当前编辑值发送一段固定测试文字，不保存设置或密钥。"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button x:Name="TestTranslationConnectionButton"
                                                    Grid.Column="1"
                                                    Content="测试连接"
                                                    Click="OnTestTranslationConnectionClick"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    AutomationProperties.Name="测试翻译连接"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock x:Name="TranslationTestStatusText"
                                                   Style="{StaticResource SettingsCaptionStyle}"
                                                   AutomationProperties.Name="翻译连接测试状态"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Margin="0,10,0,0" />
                                        <Border Style="{StaticResource SettingsToolbarStyle}" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="免费服务：MyMemory 无需密钥，但受每日与单次请求额度限制；额度用尽或网络繁忙时可能失败。MyMemory 通过 GET 请求地址接收待翻译文字，文字会发送给第三方服务，查询字符串可能被网络中间设备或代理日志看到；如需更多控制，可选择自定义翻译服务。"
                                                           Style="{StaticResource SettingsDescriptionStyle}" />
                                                <TextBlock Text="隐私：截图不会上传，仅发送识别文字给所选翻译服务，不保存翻译历史。自定义服务密钥使用 Windows DPAPI 当前用户范围加密，不会写入设置文件；导出或导入设置也不会包含密钥。"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Style="{StaticResource NavigationTabItemStyle}" AutomationProperties.Name="截图">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE7A8;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="截图" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,16,28,24" MaxWidth="1080" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                                <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE7A8;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="截图与保存" Style="{StaticResource SettingsSectionTitleStyle}" />
                                                <TextBlock Text="设置延时、格式、标注编辑器与自动保存位置" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Margin="0,16,0,0" Padding="16,8">
                                            <StackPanel>
                                                <Grid Height="58">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="截图延时" Style="{StaticResource SettingsLabelStyle}" />
                                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding CaptureDelayIndex}" Style="{StaticResource SettingsComboBoxStyle}" VerticalAlignment="Center">
                                                        <ComboBoxItem Content="立即" />
                                                        <ComboBoxItem Content="3 秒" />
                                                        <ComboBoxItem Content="5 秒" />
                                                    </ComboBox>
                                                </Grid>
                                                <Border BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <Grid Height="58">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="图片格式" Style="{StaticResource SettingsLabelStyle}" />
                                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding CaptureFormatIndex}" Style="{StaticResource SettingsComboBoxStyle}" VerticalAlignment="Center">
                                                        <ComboBoxItem Content="PNG" />
                                                        <ComboBoxItem Content="JPEG（质量 90）" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="0,12,0,0">
                                            <CheckBox Content="输出前打开标注编辑器" IsChecked="{Binding CaptureOpenEditor}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4" />
                                            <CheckBox Content="确认后自动保存到指定目录" IsChecked="{Binding CaptureAutoSave}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4" />
                                        </StackPanel>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding CaptureSaveDirectory}" IsReadOnly="True" Style="{StaticResource SettingsTextBoxStyle}" />
                                            <Button Grid.Column="1" Content="选择目录" Click="OnChooseCaptureDirectoryClick" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="标注样式" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="设置标注编辑器中的默认颜色、线宽与字号。" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,3,0,12" />
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Padding="16,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="颜色（#RRGGBB）" Style="{StaticResource SettingsLabelStyle}" />
                                                <TextBox Grid.Column="1" Text="{Binding AnnotationColor}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="1" Text="线宽（1–12px）" Style="{StaticResource SettingsLabelStyle}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StrokeWidthPx}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="2" Text="字号（10–72px）" Style="{StaticResource SettingsLabelStyle}" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FontSizePx}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Style="{StaticResource NavigationTabItemStyle}" AutomationProperties.Name="关于">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE946;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="关于" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,16,28,24" MaxWidth="1080" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource SettingsCardStyle}" Padding="26,24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="74" Height="74" CornerRadius="22" Background="{DynamicResource SettingsAccentBrush}" Margin="0,0,20,0">
                                            <TextBlock Text="月"
                                                       Foreground="White"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="月语悬浮球 1.0.0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SettingsInkBrush}" />
                                            <TextBlock Text="Windows 10/11 x64 桌面悬浮助手" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,0,0" />
                                            <TextBlock Text="作者：七月风语"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       Margin="0,12,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="GitHub：AthiefEX/YueYuOrb"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           VerticalAlignment="Center" />
                                                <Button x:Name="ProjectRepositoryLink"
                                                        Content="打开项目主页"
                                                        Click="OnProjectRepositoryClick"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        AutomationProperties.Name="打开月语悬浮球 GitHub 项目主页"
                                                        Margin="12,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="许可证：GPL-3.0-only"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       Margin="0,8,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Border Style="{StaticResource SettingsPillStyle}" Margin="0,0,8,0">
                                                    <TextBlock Text="本地保存" FontSize="12" Foreground="{DynamicResource SettingsAccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Style="{StaticResource SettingsPillStyle}">
                                                    <TextBlock Text="普通权限" FontSize="12" Foreground="{DynamicResource SettingsAccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="数据与隐私" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="数据保存在当前用户的 LocalAppData\FloatDesk。笔记、截图与 OCR 图像不会自动上传；翻译时截图不会上传，仅发送选中或识别文字给所选翻译服务。"
                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="测试连接会使用当前编辑值发送一段固定测试文字，不保存设置或密钥。翻译密钥使用 Windows DPAPI 当前用户范围加密，设置导入或导出不包含密钥。英文锁定仅对可识别的普通权限窗口生效，并遵循目标应用是否接受键盘布局切换。"
                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="兼容性说明" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="全屏置顶是尽力模式，不保证覆盖独显全屏或所有游戏。受保护内容可能截图失败。WebView2 Runtime 缺失时，本地功能仍可使用。"
                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
</TabControl>

            <Border Grid.Row="4"
                    Background="{DynamicResource SettingsCardSubtleBrush}"
                    BorderBrush="{DynamicResource SettingsLineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="30,11">
                <Grid>
                    <TextBlock x:Name="SaveStatusText"
                               Style="{StaticResource SettingsCaptionStyle}"
                               VerticalAlignment="Center"
                               Text="修改后点击应用。" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Click="OnCancelClick"
                                Margin="0,0,9,0"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="应用"
                                Click="OnApplyClick"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
