<Window x:Class="FloatDesk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="1160"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Title="FloatDesk 设置"
        Background="#F4F8FE"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FloatDesk;component/Resources/SettingsWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsShellStyle" TargetType="{x:Type Border}">
                <Setter Property="Margin" Value="7" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="#F8FBFF" />
                <Setter Property="BorderBrush" Value="#B9D3ED" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ClipToBounds" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="SettingsRoot" Style="{StaticResource SettingsShellStyle}">
        <Grid Background="#FAFCFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="88" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Grid x:Name="SettingsTitleBar"
                  Grid.Row="0"

                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#F2F8FF" />
                        <GradientStop Offset="0.55" Color="#E2F0FF" />
                        <GradientStop Offset="1" Color="#EEF8FF" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="8"
                            Background="{StaticResource SettingsAccentBrush}"
                            Margin="0,0,9,0">
                        <TextBlock Text="FD"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="FloatDesk 设置"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsInkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeSettingsButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化设置窗口">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="12" Text="&#xE921;" />
                    </Button>
                    <Button x:Name="MaximizeSettingsButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMaximizeClick"
                            AutomationProperties.Name="最大化或还原设置窗口">
                        <TextBlock x:Name="MaximizeButtonGlyph"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button x:Name="CloseSettingsButton"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="OnCloseSettingsClick"
                            AutomationProperties.Name="关闭设置窗口">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="12" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Grid.RowSpan="2"
                    CornerRadius="0,0,22,22"
                    ClipToBounds="True">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#DDEBFA" />
                            <GradientStop Offset="0.55" Color="#EEF7FF" />
                            <GradientStop Offset="1" Color="#F8FBFF" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Ellipse Width="310"
                             Height="130"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,-42,-38,0"
                             Fill="#70FFFFFF" />
                    <Ellipse Width="230"
                             Height="110"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="40,0,0,-70"
                             Fill="#55DBECFF" />
                    <Viewbox Stretch="Fill" Opacity="0.22" IsHitTestVisible="False">
                        <Canvas Width="1160" Height="148">
                            <Path Fill="#7EA6C6" Data="M0,118 L116,49 L198,97 L303,31 L414,106 L534,66 L654,112 L775,42 L904,104 L1029,63 L1160,117 L1160,148 L0,148 Z" />
                            <Path Fill="#C2D9EC" Data="M0,128 L151,81 L278,116 L431,71 L581,124 L742,83 L910,121 L1082,72 L1160,97 L1160,148 L0,148 Z" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="34,15,34,8" Panel.ZIndex="2">
                <StackPanel>
                    <TextBlock Text="FloatDesk 设置"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#17243B" />
                    <TextBlock Text="调整悬浮球、输入法、网页、笔记与截图"
                               Margin="1,3,0,0"
                               FontSize="13"
                               Foreground="#66758D" />
                </StackPanel>
                <Border Style="{StaticResource SettingsPillStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,3,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource SettingsAccentBrush}"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="本地保存 · 普通权限"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#3E5F8A"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl x:Name="SettingsTabControl"
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Style="{StaticResource SettingsTabControlStyle}"
                        SelectionChanged="OnSettingsTabSelectionChanged">                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE80F;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="常规" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,16,28,24" MaxWidth="1080" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                                <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE7B8;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="启动与外观" />
                                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="设置软件启动方式与界面外观" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Margin="0,16,0,0" Padding="16,2">
                                            <StackPanel>
                                                <Border Style="{StaticResource SettingsRowStyle}">
                                                    <CheckBox Content="随 Windows 登录启动"
                                                              IsChecked="{Binding StartWithWindows}"
                                                              Style="{StaticResource ToggleSwitchStyle}" />
                                                </Border>
                                                <Grid MinHeight="58" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="250" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="应用主题" Style="{StaticResource SettingsLabelStyle}" />
                                                        <TextBlock Text="选择 FloatDesk 的整体外观" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1"
                                                              SelectedIndex="{Binding ThemeIndex}"
                                                              Style="{StaticResource SettingsComboBoxStyle}"
                                                              VerticalAlignment="Center">
                                                        <ComboBoxItem Content="跟随系统" />
                                                        <ComboBoxItem Content="浅色" />
                                                        <ComboBoxItem Content="深色" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                                <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE765;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="快捷键" />
                                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="设置常用功能的快捷键，提升操作效率" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Margin="0,16,0,0" Padding="16,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                </Grid.RowDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="快捷面板" Style="{StaticResource SettingsLabelStyle}" />
                                                    <TextBlock Text="打开 FloatDesk 快捷面板" Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding PanelHotkey}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                    <TextBlock Text="框选截图" Style="{StaticResource SettingsLabelStyle}" />
                                                    <TextBlock Text="启动框选截图功能" Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RegionCaptureHotkey}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                                    <TextBlock Text="暂停输入规则" Style="{StaticResource SettingsLabelStyle}" />
                                                    <TextBlock Text="临时暂停输入法相关规则" Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PauseHotkey}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsToolbarStyle}" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="快捷键格式示例：Ctrl+Alt+Space、Ctrl+Shift+F8。启动时冲突会自动尝试备用组合并提示；修改时冲突会保留原绑定。"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,16,0" />
                                                <Button Grid.Column="1" Content="恢复默认偏好" Click="OnResetPreferencesClick" Style="{StaticResource ActionButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="配置文件" Style="{StaticResource SettingsSectionTitleStyle}" />
                                            <TextBlock Text="导出用于备份，或从 FloatDesk JSON 配置文件恢复设置。导入不会运行任何应用。"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="导出设置" Click="OnExportSettingsClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                            <Button Content="导入设置" Click="OnImportSettingsClick" Style="{StaticResource ActionButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE91F;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="悬浮球" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,16,28,24" MaxWidth="1080" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                                <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE91F;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="外观与尺寸" />
                                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="调整悬浮球大小、透明度与图片呈现方式" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Margin="0,16,0,0" Padding="16,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="悬浮球尺寸" Style="{StaticResource SettingsLabelStyle}" />
                                                <Slider Grid.Column="1" Minimum="32" Maximum="128" TickFrequency="4" IsSnapToTickEnabled="True" Value="{Binding OrbSizeDip}" Style="{StaticResource SettingsSliderStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding OrbSizeDip, StringFormat={}{0} px}" Style="{StaticResource SettingsCaptionStyle}" />
                                                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="1" Text="不透明度" Style="{StaticResource SettingsLabelStyle}" />
                                                <Slider Grid.Row="1" Grid.Column="1" Minimum="30" Maximum="100" Value="{Binding OrbOpacityPercent}" Style="{StaticResource SettingsSliderStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OrbOpacityPercent, StringFormat={}{0:0}%}" Style="{StaticResource SettingsCaptionStyle}" />
                                                <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="2" Text="图片裁切" Style="{StaticResource SettingsLabelStyle}" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding ImageShapeIndex}" Style="{StaticResource SettingsComboBoxStyle}" VerticalAlignment="Center">
                                                    <ComboBoxItem Content="圆形裁切" />
                                                    <ComboBoxItem Content="保留透明轮廓" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="更换悬浮球图片" Click="OnChooseOrbImageClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                            <Button Content="恢复默认图片" Click="OnResetOrbImageClick" Style="{StaticResource ActionButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="时间与位置" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="控制悬浮球上的时钟与桌面位置行为。" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,3,0,12" />
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Padding="16,4">
                                            <StackPanel>
                                                <CheckBox Content="显示时间" IsChecked="{Binding ShowClock}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                                <CheckBox Content="显示秒" IsChecked="{Binding ShowSeconds}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                                <CheckBox Content="使用 24 小时制" IsChecked="{Binding Clock24Hour}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                                <CheckBox Content="拖动后吸附屏幕边缘" IsChecked="{Binding SnapToEdge}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                                <CheckBox Content="锁定当前位置" IsChecked="{Binding PositionLocked}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="窗口层级" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="设置悬浮球在普通窗口与全屏应用中的显示方式。" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,3,0,12" />
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Padding="16,8">
                                            <StackPanel>
                                                <CheckBox Content="悬浮球始终位于普通窗口上方" IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,5,0,12" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="全屏应用期间" Style="{StaticResource SettingsLabelStyle}" />
                                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding FullscreenPolicyIndex}" Style="{StaticResource SettingsComboBoxStyle}">
                                                        <ComboBoxItem Content="跟随普通置顶" />
                                                        <ComboBoxItem Content="自动隐藏" />
                                                        <ComboBoxItem Content="尽力保持置顶" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="独占全屏、受保护界面及部分游戏覆盖层不保证显示。"
                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                   Margin="2,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE71D;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="快捷应用" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="28,16,28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="20,16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Border Style="{StaticResource SettingsIconTileStyle}">
                                            <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE71D;" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="快捷应用" Style="{StaticResource SettingsSectionTitleStyle}" />
                                            <TextBlock Text="加入同一个可滚动轮盘；未加入的应用保留在底部应用坞。移出轮盘不会删除应用。"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="添加 exe" Click="OnAddExeClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                        <Button Content="添加快捷方式" Click="OnAddShortcutClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                        <Button Content="添加文件夹" Click="OnAddFolderClick" Style="{StaticResource ActionButtonStyle}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="0">
                                <DataGrid x:Name="LauncherGrid"
                                          ItemsSource="{Binding Launchers}"
                                          Style="{StaticResource SettingsDataGridStyle}"
                                          BorderThickness="0"
                                          IsReadOnly="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" />
                                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" MinWidth="260" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80" IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="轮盘" Binding="{Binding ShowInWheel, Mode=OneWay}" Width="72" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border Grid.Row="2" Background="#F5FFFFFF" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="14,10">
                                <WrapPanel>
                                    <Button Content="移除选中项" Click="OnRemoveLauncherClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="编辑选中项" Click="OnEditLauncherClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="上移" Click="OnMoveLauncherUpClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="下移" Click="OnMoveLauncherDownClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="加入轮盘" Click="OnAddLauncherToWheelClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="移出轮盘" Click="OnRemoveLauncherFromWheelClick" Style="{StaticResource ActionButtonStyle}" />
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="WheelSettingsTab">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE80A;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="轮盘" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,16,28,24" MaxWidth="1080" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                                <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE8B0;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="内置功能" Style="{StaticResource SettingsSectionTitleStyle}" />
                                                <TextBlock Text="勾选需要显示的功能。关闭后只从轮盘移除，其他入口与设置不会改变。"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Margin="0,16,0,0" Padding="18,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="48" />
                                                    <RowDefinition Height="48" />
                                                    <RowDefinition Height="48" />
                                                    <RowDefinition Height="48" />
                                                </Grid.RowDefinitions>
                                                <CheckBox x:Name="ShowRegionCaptureInWheelCheckBox" Content="快速截图" IsChecked="{Binding ShowRegionCaptureInWheel}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" />
                                                <CheckBox x:Name="ShowWindowCaptureInWheelCheckBox" Grid.Row="1" Content="窗口截图" IsChecked="{Binding ShowWindowCaptureInWheel}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" />
                                                <CheckBox x:Name="ShowMonitorCaptureInWheelCheckBox" Grid.Row="2" Content="屏幕截图" IsChecked="{Binding ShowMonitorCaptureInWheel}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" />
                                                <CheckBox x:Name="ShowAiBrowserInWheelCheckBox" Grid.Row="3" Content="AI 网页" IsChecked="{Binding ShowAiBrowserInWheel}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" />
                                                <CheckBox x:Name="ShowNotesInWheelCheckBox" Grid.Column="1" Content="记事本" IsChecked="{Binding ShowNotesInWheel}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" />
                                                <CheckBox x:Name="ShowInputLockInWheelCheckBox" Grid.Row="1" Grid.Column="1" Content="锁定英文" IsChecked="{Binding ShowInputLockInWheel}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" />
                                                <CheckBox x:Name="ShowSettingsInWheelCheckBox" Grid.Row="2" Grid.Column="1" Content="设置" IsChecked="{Binding ShowSettingsInWheel}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SettingsIconTileStyle}">
                                            <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE71D;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="快捷应用共用同一个轮盘" Style="{StaticResource SettingsSectionTitleStyle}" />
                                            <TextBlock Text="应用数量不设上限。超出可视区域的内容会自动隐藏，使用鼠标滚轮可平滑浏览。请前往“快捷应用”页面选择“加入轮盘”或“移出轮盘”。"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE765;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="输入法" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="28,16,28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="20,16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <Border Style="{StaticResource SettingsIconTileStyle}">
                                            <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE765;" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="指定应用自动锁定英文" Style="{StaticResource SettingsSectionTitleStyle}" />
                                            <TextBlock Text="目标应用进入前台时，按下方规则切换键盘布局。" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Content="启用自动规则"
                                              IsChecked="{Binding AutoInputEnabled}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="70" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{StaticResource SettingsAccentPaleBrush}" CornerRadius="16,16,0,0" Padding="18,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="目标键盘布局" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Grid.Column="1" Text="{Binding TargetKlid}" Style="{StaticResource SettingsTextBoxStyle}" />
                                            <TextBlock Grid.Column="2" Text="默认 00000409（英语美国，非 IME）" Style="{StaticResource SettingsCaptionStyle}" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="1"
                                              x:Name="InputRuleGrid"
                                              ItemsSource="{Binding InputRules}"
                                              Style="{StaticResource SettingsDataGridStyle}"
                                              BorderThickness="0"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="应用路径" Binding="{Binding ExePath}" Width="*" MinWidth="340" />
                                            <DataGridTemplateColumn Header="动作" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.InputActions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource SettingsComboBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="74" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Content="添加应用规则" Click="OnAddInputRuleClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="添加当前前台应用" Click="OnAddCurrentAppClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="移除选中规则" Click="OnRemoveInputRuleClick" Style="{StaticResource ActionButtonStyle}" />
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE774;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="AI 网页" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="28,16,28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="20,16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <Border Style="{StaticResource SettingsIconTileStyle}">
                                            <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE774;" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="网页窗口行为" Style="{StaticResource SettingsSectionTitleStyle}" />
                                            <TextBlock Text="悬浮球内打开 AI 网页时使用的窗口与缩放设置。" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox Content="关闭窗口即释放网页" IsChecked="{Binding BrowserReleaseOnClose}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,8" />
                                        <CheckBox Content="AI 窗口独立置顶" IsChecked="{Binding BrowserTopmost}" Style="{StaticResource ToggleSwitchStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="64" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{StaticResource SettingsAccentPaleBrush}" CornerRadius="16,16,0,0" Padding="18,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="网页缩放（%）" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Grid.Column="1" Text="{Binding BrowserZoomPercent}" Style="{StaticResource SettingsTextBoxStyle}" />
                                            <TextBlock Grid.Column="2" Text="仅在完成修改后点击底部“应用”保存。" Style="{StaticResource SettingsCaptionStyle}" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="1"
                                              x:Name="BrowserSitesGrid"
                                              ItemsSource="{Binding BrowserSites}"
                                              Style="{StaticResource SettingsDataGridStyle}"
                                              BorderThickness="0"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="HTTPS 地址" Binding="{Binding Url}" Width="*" MinWidth="340" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Content="添加网页" Click="OnAddSiteClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="编辑选中网页" Click="OnEditSiteClick" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="移除选中网页" Click="OnRemoveSiteClick" Style="{StaticResource ActionButtonStyle}" />
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE7A8;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="截图" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,16,28,24" MaxWidth="1080" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                                <TextBlock Style="{StaticResource SettingsIconGlyphStyle}" Text="&#xE7A8;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="截图与保存" Style="{StaticResource SettingsSectionTitleStyle}" />
                                                <TextBlock Text="设置延时、格式、标注编辑器与自动保存位置" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Margin="0,16,0,0" Padding="16,8">
                                            <StackPanel>
                                                <Grid Height="58">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="截图延时" Style="{StaticResource SettingsLabelStyle}" />
                                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding CaptureDelayIndex}" Style="{StaticResource SettingsComboBoxStyle}" VerticalAlignment="Center">
                                                        <ComboBoxItem Content="立即" />
                                                        <ComboBoxItem Content="3 秒" />
                                                        <ComboBoxItem Content="5 秒" />
                                                    </ComboBox>
                                                </Grid>
                                                <Border BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <Grid Height="58">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="图片格式" Style="{StaticResource SettingsLabelStyle}" />
                                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding CaptureFormatIndex}" Style="{StaticResource SettingsComboBoxStyle}" VerticalAlignment="Center">
                                                        <ComboBoxItem Content="PNG" />
                                                        <ComboBoxItem Content="JPEG（质量 90）" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="0,12,0,0">
                                            <CheckBox Content="输出前打开标注编辑器" IsChecked="{Binding CaptureOpenEditor}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4" />
                                            <CheckBox Content="确认后自动保存到指定目录" IsChecked="{Binding CaptureAutoSave}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4" />
                                        </StackPanel>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding CaptureSaveDirectory}" IsReadOnly="True" Style="{StaticResource SettingsTextBoxStyle}" />
                                            <Button Grid.Column="1" Content="选择目录" Click="OnChooseCaptureDirectoryClick" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="标注样式" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="设置标注编辑器中的默认颜色、线宽与字号。" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,3,0,12" />
                                        <Border Style="{StaticResource SettingsSubtleCardStyle}" Padding="16,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="58" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="颜色（#RRGGBB）" Style="{StaticResource SettingsLabelStyle}" />
                                                <TextBox Grid.Column="1" Text="{Binding AnnotationColor}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="1" Text="线宽（1–12px）" Style="{StaticResource SettingsLabelStyle}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StrokeWidthPx}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Row="2" Text="字号（10–72px）" Style="{StaticResource SettingsLabelStyle}" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FontSizePx}" Style="{StaticResource SettingsTextBoxStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="15" Text="&#xE946;" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="关于" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,16,28,24" MaxWidth="1080" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource SettingsCardStyle}" Padding="26,24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="74" Height="74" CornerRadius="22" Background="{StaticResource SettingsAccentBrush}" Margin="0,0,20,0">
                                            <TextBlock Text="FD"
                                                       Foreground="White"
                                                       FontSize="25"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="FloatDesk 1.0.0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource SettingsInkBrush}" />
                                            <TextBlock Text="Windows 10/11 x64 桌面悬浮助手" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Border Style="{StaticResource SettingsPillStyle}" Margin="0,0,8,0">
                                                    <TextBlock Text="本地保存" FontSize="12" Foreground="{StaticResource SettingsAccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Style="{StaticResource SettingsPillStyle}">
                                                    <TextBlock Text="普通权限" FontSize="12" Foreground="{StaticResource SettingsAccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="数据与隐私" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="数据保存在当前用户的 LocalAppData\FloatDesk。笔记与截图不会自动上传。英文锁定仅对可识别的普通权限窗口生效，并遵循目标应用是否接受键盘布局切换。"
                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="兼容性说明" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="全屏置顶是尽力模式，不保证覆盖独显全屏或所有游戏。受保护内容可能截图失败。WebView2 Runtime 缺失时，本地功能仍可使用。"
                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
</TabControl>

            <Border Grid.Row="4"
                    Background="#F5FFFFFF"
                    BorderBrush="{StaticResource SettingsLineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="30,11">
                <Grid>
                    <TextBlock x:Name="SaveStatusText"
                               Style="{StaticResource SettingsCaptionStyle}"
                               VerticalAlignment="Center"
                               Text="修改后点击应用。" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Click="OnCancelClick"
                                Margin="0,0,9,0"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="应用"
                                Click="OnApplyClick"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
