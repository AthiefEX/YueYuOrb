<Window x:Class="FloatDesk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="1160"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Title="FloatDesk 设置"
        Background="#F4F8FE"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FloatDesk;component/Resources/SettingsWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsShellStyle" TargetType="{x:Type Border}">
                <Setter Property="Margin" Value="7" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="#F8FBFF" />
                <Setter Property="BorderBrush" Value="#B9D3ED" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ClipToBounds" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="SettingsRoot" Style="{StaticResource SettingsShellStyle}">
        <Grid Background="#FAFCFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="88" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Grid x:Name="SettingsTitleBar"
                  Grid.Row="0"

                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#F2F8FF" />
                        <GradientStop Offset="0.55" Color="#E2F0FF" />
                        <GradientStop Offset="1" Color="#EEF8FF" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="8"
                            Background="{StaticResource SettingsAccentBrush}"
                            Margin="0,0,9,0">
                        <TextBlock Text="FD"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="FloatDesk 设置"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsInkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeSettingsButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化设置窗口">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="12" Text="&#xE921;" />
                    </Button>
                    <Button x:Name="MaximizeSettingsButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMaximizeClick"
                            AutomationProperties.Name="最大化或还原设置窗口">
                        <TextBlock x:Name="MaximizeButtonGlyph"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button x:Name="CloseSettingsButton"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="OnCloseSettingsClick"
                            AutomationProperties.Name="关闭设置窗口">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="12" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Grid.RowSpan="2"
                    CornerRadius="0,0,22,22"
                    ClipToBounds="True">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#DDEBFA" />
                            <GradientStop Offset="0.55" Color="#EEF7FF" />
                            <GradientStop Offset="1" Color="#F8FBFF" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Ellipse Width="310"
                             Height="130"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,-42,-38,0"
                             Fill="#70FFFFFF" />
                    <Ellipse Width="230"
                             Height="110"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="40,0,0,-70"
                             Fill="#55DBECFF" />
                    <Viewbox Stretch="Fill" Opacity="0.22" IsHitTestVisible="False">
                        <Canvas Width="1160" Height="148">
                            <Path Fill="#7EA6C6" Data="M0,118 L116,49 L198,97 L303,31 L414,106 L534,66 L654,112 L775,42 L904,104 L1029,63 L1160,117 L1160,148 L0,148 Z" />
                            <Path Fill="#C2D9EC" Data="M0,128 L151,81 L278,116 L431,71 L581,124 L742,83 L910,121 L1082,72 L1160,97 L1160,148 L0,148 Z" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="34,15,34,8" Panel.ZIndex="2">
                <StackPanel>
                    <TextBlock Text="FloatDesk 设置"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#17243B" />
                    <TextBlock Text="调整悬浮球、输入法、网页、笔记与截图"
                               Margin="1,3,0,0"
                               FontSize="13"
                               Foreground="#66758D" />
                </StackPanel>
                <Border Style="{StaticResource SettingsPillStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,3,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource SettingsAccentBrush}"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="本地保存 · 普通权限"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#3E5F8A"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl x:Name="SettingsTabControl"
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Style="{StaticResource SettingsTabControlStyle}"
                        SelectionChanged="OnSettingsTabSelectionChanged"><TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="15"
                                   Text="&#xE80F;"
                                   Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="常规"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="12">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="启动与外观" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <CheckBox Content="随 Windows 登录启动"
                                  IsChecked="{Binding StartWithWindows}"
                                  Margin="0,0,0,12" />
                        <TextBlock Text="应用主题" Margin="0,0,0,6" />
                        <ComboBox SelectedIndex="{Binding ThemeIndex}" Margin="0,0,0,14">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                        <TextBlock Text="快捷键" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="快捷面板" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PanelHotkey}" />
                            <TextBlock Grid.Row="1" Text="框选截图" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RegionCaptureHotkey}" />
                            <TextBlock Grid.Row="2" Text="暂停输入规则" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PauseHotkey}" />
                        </Grid>
                        <TextBlock Text="快捷键格式示例：Ctrl+Alt+Space、Ctrl+Shift+F8。启动时冲突会自动尝试备用组合并提示；修改时冲突会保留原绑定。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   Margin="0,8,0,0" />
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="导出设置"
                                    Click="OnExportSettingsClick"
                                    Margin="0,0,8,0" />
                            <Button Content="导入设置"
                                    Click="OnImportSettingsClick"
                                    Margin="0,0,8,0" />
                            <Button Content="恢复默认偏好"
                                    Click="OnResetPreferencesClick" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="15"
                                   Text="&#xE91F;"
                                   Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="悬浮球"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="12">
                    <StackPanel MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" />
                                <RowDefinition Height="46" />
                                <RowDefinition Height="46" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="球径（32–128）" VerticalAlignment="Center" />
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Minimum="32" Maximum="128"
                                    TickFrequency="4"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding OrbSizeDip}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="不透明度（%）" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1"
                                    Minimum="30" Maximum="100"
                                    Value="{Binding OrbOpacityPercent}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="图片裁切" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      SelectedIndex="{Binding ImageShapeIndex}"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="圆形裁切" />
                                <ComboBoxItem Content="保留透明轮廓" />
                            </ComboBox>
                        </Grid>
                        <WrapPanel Margin="0,10,0,14">
                            <Button Content="更换悬浮球图片" Click="OnChooseOrbImageClick" Margin="0,0,8,0" />
                            <Button Content="恢复默认图片" Click="OnResetOrbImageClick" />
                        </WrapPanel>
                        <CheckBox Content="显示时间" IsChecked="{Binding ShowClock}" Margin="0,0,0,10" />
                        <CheckBox Content="显示秒" IsChecked="{Binding ShowSeconds}" Margin="0,0,0,10" />
                        <CheckBox Content="使用 24 小时制" IsChecked="{Binding Clock24Hour}" Margin="0,0,0,10" />
                        <CheckBox Content="拖动后吸附屏幕边缘" IsChecked="{Binding SnapToEdge}" Margin="0,0,0,10" />
                        <CheckBox Content="锁定当前位置" IsChecked="{Binding PositionLocked}" Margin="0,0,0,18" />

                        <TextBlock Text="窗口层级" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox Content="悬浮球始终位于普通窗口上方" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,10" />
                        <TextBlock Text="全屏应用期间" Margin="0,0,0,6" />
                        <ComboBox SelectedIndex="{Binding FullscreenPolicyIndex}" Margin="0,0,0,8">
                            <ComboBoxItem Content="跟随普通置顶" />
                            <ComboBoxItem Content="自动隐藏" />
                            <ComboBoxItem Content="尽力保持置顶" />
                        </ComboBox>
                        <TextBlock Text="独占全屏、受保护界面及部分游戏覆盖层不保证显示。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="15"
                                   Text="&#xE71D;"
                                   Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="快捷应用"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="添加 exe" Click="OnAddExeClick" Margin="0,0,8,0" />
                            <Button Content="添加快捷方式" Click="OnAddShortcutClick" Margin="0,0,8,0" />
                            <Button Content="添加文件夹" Click="OnAddFolderClick" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="加入轮盘的应用与功能共用一个可滚动轮盘；未加入的应用显示在底部应用坞。移出轮盘不会删除应用。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              x:Name="LauncherGrid"
                              ItemsSource="{Binding Launchers}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" />
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="70" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="轮盘"
                                                    Binding="{Binding ShowInWheel, Mode=OneWay}"
                                                    Width="70"
                                                    IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="移除选中项"
                                Click="OnRemoveLauncherClick"
                                Margin="0,0,8,0" />
                        <Button Content="编辑选中项"
                                Click="OnEditLauncherClick"
                                Margin="0,0,8,0" />
                        <Button Content="上移"
                                Click="OnMoveLauncherUpClick"
                                Margin="0,0,8,0" />
                        <Button Content="下移"
                                Click="OnMoveLauncherDownClick"
                                Margin="0,0,8,0" />
                        <Button Content="加入轮盘"
                                Click="OnAddLauncherToWheelClick"
                                Margin="0,0,8,0" />
                        <Button Content="移出轮盘"
                                Click="OnRemoveLauncherFromWheelClick" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="WheelSettingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="15"
                                   Text="&#xE80A;"
                                   Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="轮盘"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="12">
                    <StackPanel MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="内置功能"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="勾选需要显示的功能。关闭后该功能只会从轮盘移除，其他入口与设置不会改变。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   Margin="0,0,0,14" />
                        <Border Background="#0D2E8BFF"
                                CornerRadius="12"
                                Padding="18,12"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="ShowRegionCaptureInWheelCheckBox"
                                          Content="快速截图"
                                          IsChecked="{Binding ShowRegionCaptureInWheel}"
                                          VerticalAlignment="Center" />
                                <CheckBox x:Name="ShowWindowCaptureInWheelCheckBox"
                                          Grid.Row="1"
                                          Content="窗口截图"
                                          IsChecked="{Binding ShowWindowCaptureInWheel}"
                                          VerticalAlignment="Center" />
                                <CheckBox x:Name="ShowMonitorCaptureInWheelCheckBox"
                                          Grid.Row="2"
                                          Content="屏幕截图"
                                          IsChecked="{Binding ShowMonitorCaptureInWheel}"
                                          VerticalAlignment="Center" />
                                <CheckBox x:Name="ShowAiBrowserInWheelCheckBox"
                                          Grid.Row="3"
                                          Content="AI 网页"
                                          IsChecked="{Binding ShowAiBrowserInWheel}"
                                          VerticalAlignment="Center" />
                                <CheckBox x:Name="ShowNotesInWheelCheckBox"
                                          Grid.Column="1"
                                          Content="记事本"
                                          IsChecked="{Binding ShowNotesInWheel}"
                                          VerticalAlignment="Center" />
                                <CheckBox x:Name="ShowInputLockInWheelCheckBox"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Content="锁定英文"
                                          IsChecked="{Binding ShowInputLockInWheel}"
                                          VerticalAlignment="Center" />
                                <CheckBox x:Name="ShowSettingsInWheelCheckBox"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          Content="设置"
                                          IsChecked="{Binding ShowSettingsInWheel}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock Text="快捷应用"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,8" />
                        <TextBlock Text="前往“快捷应用”页面选择应用，再点击“加入轮盘”或“移出轮盘”。应用数量不设上限，超出可视区域的内容可使用鼠标滚轮浏览，轮盘曲线会随着滚动保持整齐。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="15"
                                   Text="&#xE765;"
                                   Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="输入法"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox Content="启用指定应用自动锁定英文"
                              IsChecked="{Binding AutoInputEnabled}"
                              Margin="0,0,0,12" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="目标键盘布局" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding TargetKlid}" Width="120" />
                        <TextBlock Text="默认 00000409（英语美国，非 IME）"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="2"
                              x:Name="InputRuleGrid"
                              ItemsSource="{Binding InputRules}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="应用路径" Binding="{Binding ExePath}" Width="*" />
                            <DataGridTemplateColumn Header="动作" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.InputActions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="添加应用规则" Click="OnAddInputRuleClick" Margin="0,0,8,0" />
                        <Button Content="添加当前前台应用" Click="OnAddCurrentAppClick" Margin="0,0,8,0" />
                        <Button Content="移除选中规则" Click="OnRemoveInputRuleClick" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="15"
                                   Text="&#xE774;"
                                   Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="AI 网页"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <CheckBox Content="关闭窗口即释放网页（未发送内容会丢失）"
                                  IsChecked="{Binding BrowserReleaseOnClose}"
                                  Margin="0,0,0,10" />
                        <CheckBox Content="AI 窗口独立置顶"
                                  IsChecked="{Binding BrowserTopmost}"
                                  Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="网页缩放（%）" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding BrowserZoomPercent}" Width="90" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              x:Name="BrowserSitesGrid"
                              ItemsSource="{Binding BrowserSites}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="HTTPS 地址" Binding="{Binding Url}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="添加网页" Click="OnAddSiteClick" Margin="0,0,8,0" />
                        <Button Content="编辑选中网页"
                                Click="OnEditSiteClick"
                                Margin="0,0,8,0" />
                        <Button Content="移除选中网页" Click="OnRemoveSiteClick" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="15"
                                   Text="&#xE7A8;"
                                   Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="截图"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="12">
                    <StackPanel MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="截图" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" />
                                <RowDefinition Height="46" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="延时" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding CaptureDelayIndex}" VerticalAlignment="Center">
                                <ComboBoxItem Content="立即" />
                                <ComboBoxItem Content="3 秒" />
                                <ComboBoxItem Content="5 秒" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="格式" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding CaptureFormatIndex}" VerticalAlignment="Center">
                                <ComboBoxItem Content="PNG" />
                                <ComboBoxItem Content="JPEG（质量 90）" />
                            </ComboBox>
                        </Grid>
                        <CheckBox Content="输出前打开标注编辑器" IsChecked="{Binding CaptureOpenEditor}" Margin="0,14,0,10" />
                        <CheckBox Content="确认后自动保存到指定目录" IsChecked="{Binding CaptureAutoSave}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Text="{Binding CaptureSaveDirectory}" Width="420" IsReadOnly="True" />
                            <Button Content="选择目录" Click="OnChooseCaptureDirectoryClick" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="标注" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="颜色（#RRGGBB）" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding AnnotationColor}" />
                            <TextBlock Grid.Row="1" Text="线宽（1–12px）" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StrokeWidthPx}" />
                            <TextBlock Grid.Row="2" Text="字号（10–72px）" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FontSizePx}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="15"
                                   Text="&#xE946;"
                                   Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="关于"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="24">
                    <TextBlock Text="FloatDesk 1.0.0" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Windows 10/11 x64 桌面悬浮助手" Margin="0,8,0,20" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="650">
                        数据保存在当前用户的 LocalAppData\FloatDesk。笔记与截图不会自动上传。
                        英文锁定仅对可识别的普通权限窗口生效，并遵循目标应用是否接受键盘布局切换。
                    </TextBlock>
                    <Separator Margin="0,20" />
                    <TextBlock Text="兼容性说明" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="650"
                               Foreground="{DynamicResource MutedInkBrush}">
                        全屏置顶是尽力模式，不保证覆盖独显全屏或所有游戏。受保护内容可能截图失败。
                        WebView2 Runtime 缺失时，本地功能仍可使用。
                    </TextBlock>
                </StackPanel>
            </TabItem>
                    </TabControl>

            <Border Grid.Row="4"
                    Background="#F5FFFFFF"
                    BorderBrush="{StaticResource SettingsLineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="30,11">
                <Grid>
                    <TextBlock x:Name="SaveStatusText"
                               Style="{StaticResource SettingsCaptionStyle}"
                               VerticalAlignment="Center"
                               Text="修改后点击应用。" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Click="OnCancelClick"
                                Margin="0,0,9,0"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="应用"
                                Click="OnApplyClick"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
