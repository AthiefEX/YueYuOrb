<Window x:Class="FloatDesk.App.Views.CaptureEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatDesk 截图标注"
        Width="980"
        Height="720"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">
    <Grid Background="#222725">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#F7F7F4" Padding="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="RectangleToolButton"
                            Content="矩形"
                            Click="OnRectangleToolClick"
                            Margin="0,0,6,0" />
                    <Button x:Name="ArrowToolButton"
                            Content="箭头"
                            Click="OnArrowToolClick"
                            Margin="0,0,6,0" />
                    <Button x:Name="TextToolButton"
                            Content="文字"
                            Click="OnTextToolClick"
                            Margin="0,0,14,0" />
                    <Button Content="撤销"
                            Click="OnUndoClick"
                            Margin="0,0,6,0" />
                    <Button Content="重做"
                            Click="OnRedoClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Click="OnCancelClick"
                            Margin="0,0,6,0" />
                    <Button Content="另存为"
                            Click="OnSaveAsClick"
                            Margin="0,0,6,0" />
                    <Button Content="复制并完成"
                            Click="OnConfirmClick"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              x:Name="Viewport"
              Background="#171A19"
              Margin="14"
              ClipToBounds="True">
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both">
                <Grid x:Name="EditorSurface"
                      Background="Black"
                      MouseLeftButtonDown="OnSurfaceMouseDown"
                      MouseMove="OnSurfaceMouseMove"
                      MouseLeftButtonUp="OnSurfaceMouseUp">
                    <Image x:Name="CaptureImage"
                           Stretch="Fill"
                           SnapsToDevicePixels="True" />
                    <Canvas x:Name="AnnotationCanvas"
                            IsHitTestVisible="False" />
                </Grid>
            </Viewbox>
        </Grid>

        <Border Grid.Row="2"
                Background="#F7F7F4"
                Padding="12,9">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedInkBrush}"
                           Text="选择标注工具后在图上拖动；Ctrl+C 复制，Ctrl+S 另存。" />
                <TextBlock x:Name="PixelSizeText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedInkBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
