<Window x:Class="FloatDesk.App.Views.CaptureEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="月语悬浮球截图标注"
        Width="980"
        Height="720"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsWindowBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YueYuOrb;component/Resources/SettingsWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource SettingsWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SettingsCardBrush}"
                BorderBrush="{DynamicResource SettingsLineBrush}"
                BorderThickness="0,0,0,1"
                Padding="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="RectangleToolButton"
                            Content="矩形"
                            Click="OnRectangleToolClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0" />
                    <Button x:Name="ArrowToolButton"
                            Content="箭头"
                            Click="OnArrowToolClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0" />
                    <Button x:Name="TextToolButton"
                            Content="文字"
                            Click="OnTextToolClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,14,0" />
                    <Button Content="撤销"
                            Click="OnUndoClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0" />
                    <Button Content="重做"
                            Click="OnRedoClick"
                            Style="{StaticResource ToolbarButtonStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Click="OnCancelClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0" />
                    <Button Content="另存为"
                            Click="OnSaveAsClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0" />
                    <Button Content="复制并完成"
                            Click="OnConfirmClick"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              x:Name="Viewport"
              Background="{DynamicResource ToolWindowEditorBrush}"
              Margin="14"
              ClipToBounds="True">
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both">
                <Grid x:Name="EditorSurface"
                      Background="Black"
                      MouseLeftButtonDown="OnSurfaceMouseDown"
                      MouseMove="OnSurfaceMouseMove"
                      MouseLeftButtonUp="OnSurfaceMouseUp">
                    <Image x:Name="CaptureImage"
                           Stretch="Fill"
                           SnapsToDevicePixels="True" />
                    <Canvas x:Name="AnnotationCanvas"
                            IsHitTestVisible="False" />
                </Grid>
            </Viewbox>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SettingsCardBrush}"
                BorderBrush="{DynamicResource SettingsLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,9">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedInkBrush}"
                           Text="选择标注工具后在图上拖动；Ctrl+C 复制，Ctrl+S 另存。" />
                <TextBlock x:Name="PixelSizeText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedInkBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
