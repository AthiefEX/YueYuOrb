<Window x:Class="FloatDesk.App.Views.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="660"
        Height="560"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        Title="FloatDesk 快捷面板">
    <Window.Resources>
        <SolidColorBrush x:Key="MenuLabelBrush" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="MenuLabelBorderBrush" Color="#A8DCEBFF" />
        <SolidColorBrush x:Key="MenuMutedBrush" Color="#667B92B7" />
        <SolidColorBrush x:Key="MenuStrongBrush" Color="#FF18345B" />
        <SolidColorBrush x:Key="MenuBlueBrush" Color="#FF2E8BFF" />
        <SolidColorBrush x:Key="MenuGreenBrush" Color="#FF25C89A" />
        <SolidColorBrush x:Key="MenuVioletBrush" Color="#FF9B59F6" />
        <SolidColorBrush x:Key="MenuCoralBrush" Color="#FFFF6B70" />
        <SolidColorBrush x:Key="MenuSlateBrush" Color="#FF758197" />

        <LinearGradientBrush x:Key="MenuFanBrush"
                             StartPoint="1,0.5"
                             EndPoint="0,0.5">
            <GradientStop Color="#A8FFFFFF" Offset="0" />
            <GradientStop Color="#52E7F4FF" Offset="0.46" />
            <GradientStop Color="#0CFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MenuFanEdgeBrush"
                             StartPoint="1,0.5"
                             EndPoint="0,0.5">
            <GradientStop Color="#86FFFFFF" Offset="0" />
            <GradientStop Color="#5597D4F4" Offset="0.58" />
            <GradientStop Color="#168DCAEB" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="AnchorHaloBrush">
            <GradientStop Color="#BFFFFFFF" Offset="0" />
            <GradientStop Color="#4D9BD8FF" Offset="0.55" />
            <GradientStop Color="#009BD8FF" Offset="1" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="DockGlassBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#EFFFFFFF" Offset="0" />
            <GradientStop Color="#DCEAF5FF" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="MenuShadow"
                          BlurRadius="24"
                          ShadowDepth="8"
                          Direction="270"
                          Opacity="0.18"
                          Color="#254E91" />
        <DropShadowEffect x:Key="ActionShadow"
                          BlurRadius="13"
                          ShadowDepth="3"
                          Direction="270"
                          Opacity="0.20"
                          Color="#315D8D" />

        <Style x:Key="RadialActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ActionRoot"
                              RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionRoot"
                                        Property="Opacity"
                                        Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionRoot"
                                        Property="Opacity"
                                        Value="0.82" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockLauncherButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#D9FFFFFF" />
            <Setter Property="BorderBrush" Value="#80CBE4FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MenuStrongBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DockButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DockButtonSurface"
                                        Property="Background"
                                        Value="#FFFFFFFF" />
                                <Setter TargetName="DockButtonSurface"
                                        Property="BorderBrush"
                                        Value="{StaticResource MenuBlueBrush}" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MenuRoot"
          Width="660"
          Height="560"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="MenuScaleTransform"
                            ScaleX="0.97"
                            ScaleY="0.97" />
        </Grid.RenderTransform>

        <Canvas x:Name="MenuCanvas"
                Width="660"
                Height="560">
            <Path x:Name="FanWash"
                  Fill="{StaticResource MenuFanBrush}"
                  IsHitTestVisible="False"
                  Opacity="0.72">
                <Path.Effect>
                    <BlurEffect Radius="18" />
                </Path.Effect>
            </Path>
            <Path x:Name="FanHighlight"
                  Fill="#20FFFFFF"
                  IsHitTestVisible="False"
                  Opacity="0.52">
                <Path.Effect>
                    <BlurEffect Radius="9" />
                </Path.Effect>
            </Path>
            <Path x:Name="FanRim"
                  Fill="Transparent"
                  Stroke="{StaticResource MenuFanEdgeBrush}"
                  StrokeThickness="1"
                  Opacity="0.48"
                  IsHitTestVisible="False" />
            <Path x:Name="ConnectorPath"
                  IsHitTestVisible="False"
                  Stroke="#4D8EC8F4"
                  StrokeThickness="1"
                  Opacity="0.78" />

            <Ellipse x:Name="AnchorHalo"
                     Width="146"
                     Height="146"
                     Fill="{StaticResource AnchorHaloBrush}"
                     IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="18" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="AnchorRing"
                     Width="108"
                     Height="108"
                     Stroke="#BFFFFFFF"
                     StrokeThickness="2"
                     Fill="#12FFFFFF"
                     IsHitTestVisible="False" />
            <Ellipse x:Name="AnchorOrbitSmall"
                     Width="126"
                     Height="126"
                     Stroke="#4891CAFF"
                     StrokeThickness="1"
                     Fill="Transparent"
                     IsHitTestVisible="False" />
            <Ellipse x:Name="AnchorOrbitLarge"
                     Width="170"
                     Height="170"
                     Stroke="#247EBDFF"
                     StrokeThickness="0.8"
                     Fill="Transparent"
                     IsHitTestVisible="False" />
            <ScrollViewer x:Name="WheelLauncherScroller"
                          Width="234"
                          Height="380"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          ClipToBounds="True"
                          PreviewMouseWheel="OnWheelLauncherMouseWheel">
                <StackPanel x:Name="WheelLauncherPanel"
                            Orientation="Vertical"
                            HorizontalAlignment="Stretch" />
            </ScrollViewer>

            <Button x:Name="RegionCaptureButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnRegionCaptureClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuGreenBrush}"
                            BorderBrush="#DFFFFFFF"
                            BorderThickness="2"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE722;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="{StaticResource MenuLabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="快速截图"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="WindowCaptureButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnWindowCaptureClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuBlueBrush}"
                            BorderBrush="#DFFFFFFF"
                            BorderThickness="2"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE7C4;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="{StaticResource MenuLabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="窗口"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="MonitorCaptureButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnMonitorCaptureClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuBlueBrush}"
                            BorderBrush="#DFFFFFFF"
                            BorderThickness="2"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE7F4;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="{StaticResource MenuLabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="屏幕"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="AiButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnAiClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuVioletBrush}"
                            BorderBrush="#DFFFFFFF"
                            BorderThickness="2"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE8BD;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="{StaticResource MenuLabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="AI 网页"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="NotesButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnNotesClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuCoralBrush}"
                            BorderBrush="#DFFFFFFF"
                            BorderThickness="2"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE70B;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="{StaticResource MenuLabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="记事本"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="InputLockButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnInputLockClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="InputLockGlyphHost"
                            Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuBlueBrush}"
                            BorderBrush="#DFFFFFFF"
                            BorderThickness="2"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock x:Name="InputLockGlyph"
                                   Text="&#xE72E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="19"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="{StaticResource MenuLabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock x:Name="InputLockTitle"
                                   Text="锁定英文"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="SettingsButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnSettingsClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuSlateBrush}"
                            BorderBrush="#DFFFFFFF"
                            BorderThickness="2"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="{StaticResource MenuLabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="设置"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Border x:Name="LauncherDock"
                    Width="480"
                    Height="64"
                    Background="{StaticResource DockGlassBrush}"
                    BorderBrush="#91CAE4FF"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="10,7">
                <Border.Effect>
                    <StaticResource ResourceKey="MenuShadow" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="快捷应用"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="LauncherCountText"
                                   Foreground="{StaticResource MenuMutedBrush}"
                                   FontSize="11"
                                   Text="0 个项目" />
                    </StackPanel>
                    <ScrollViewer x:Name="LauncherScroller"
                                  Grid.Column="1"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  PanningMode="HorizontalOnly"
                                  PreviewMouseWheel="OnLauncherMouseWheel">
                        <StackPanel x:Name="LauncherPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
