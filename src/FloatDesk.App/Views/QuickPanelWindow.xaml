<Window x:Class="FloatDesk.App.Views.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340"
        SizeToContent="Height"
        MaxHeight="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        Title="FloatDesk 快捷面板">
    <Border Style="{StaticResource PanelBorderStyle}" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.24" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="FloatDesk"
                           FontSize="19"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="AutoRuleText"
                               Foreground="{DynamicResource MutedInkBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button Content="设置"
                            Click="OnSettingsClick"
                            Padding="10,5"
                            MinHeight="30" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          MaxHeight="190"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,10">
                <WrapPanel x:Name="LauncherPanel"
                           MinHeight="72" />
            </ScrollViewer>

            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
                <Button x:Name="InputLockButton"
                        Content="锁定英文"
                        Margin="0,0,6,0"
                        Click="OnInputLockClick" />
                <Button Content="AI 网页"
                        Margin="3,0"
                        Click="OnAiClick" />
                <Button Content="记事本"
                        Margin="6,0,0,0"
                        Click="OnNotesClick" />
            </UniformGrid>

            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RegionCaptureButton"
                        Grid.Column="0"
                        Content="框选截图"
                        Margin="0,0,6,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnRegionCaptureClick" />
                <UniformGrid Grid.Column="1" Columns="2">
                    <Button Content="窗口"
                            Margin="3,0"
                            Click="OnWindowCaptureClick" />
                    <Button Content="屏幕"
                            Margin="6,0,0,0"
                            Click="OnMonitorCaptureClick" />
                </UniformGrid>
            </Grid>

            <Border Grid.Row="4"
                    Background="#0E146C5B"
                    CornerRadius="8"
                    Padding="9,7">
                <TextBlock x:Name="InputStatusText"
                           Foreground="{DynamicResource MutedInkBrush}"
                           TextWrapping="Wrap"
                           Text="输入状态：等待前台应用" />
            </Border>
        </Grid>
    </Border>
</Window>
