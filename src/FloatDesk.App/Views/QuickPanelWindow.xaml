<Window x:Class="FloatDesk.App.Views.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="660"
        Height="560"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        Title="FloatDesk 快捷面板">
    <Window.Resources>
        <SolidColorBrush x:Key="MenuLabelBrush" Color="#F5FFFFFF" />
        <SolidColorBrush x:Key="MenuMutedBrush" Color="#667B92B7" />
        <SolidColorBrush x:Key="MenuStrongBrush" Color="#FF18345B" />
        <RadialGradientBrush x:Key="MenuBlueBrush"
                             GradientOrigin="0.28,0.22">
            <GradientStop Color="#70B8FF" Offset="0" />
            <GradientStop Color="#2E8BFF" Offset="0.58" />
            <GradientStop Color="#1E75E8" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="MenuGreenBrush"
                             GradientOrigin="0.28,0.22">
            <GradientStop Color="#68E1B7" Offset="0" />
            <GradientStop Color="#25C89A" Offset="0.58" />
            <GradientStop Color="#13A97E" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="MenuVioletBrush"
                             GradientOrigin="0.28,0.22">
            <GradientStop Color="#B98CFF" Offset="0" />
            <GradientStop Color="#8C56F0" Offset="0.58" />
            <GradientStop Color="#7040D7" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="MenuCoralBrush"
                             GradientOrigin="0.28,0.22">
            <GradientStop Color="#FF9B9E" Offset="0" />
            <GradientStop Color="#FF6B70" Offset="0.58" />
            <GradientStop Color="#E95058" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="MenuSlateBrush"
                             GradientOrigin="0.28,0.22">
            <GradientStop Color="#9CA8B8" Offset="0" />
            <GradientStop Color="#758197" Offset="0.58" />
            <GradientStop Color="#616C80" Offset="1" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="MenuFanBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#B8FFFFFF" Offset="0" />
            <GradientStop Color="#72F3F9FF" Offset="0.62" />
            <GradientStop Color="#38E6F2FF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ActionBeamBrush" Color="#34FFFFFF" />
        <RadialGradientBrush x:Key="AnchorHaloBrush">
            <GradientStop Color="#BFFFFFFF" Offset="0" />
            <GradientStop Color="#4D9BD8FF" Offset="0.55" />
            <GradientStop Color="#009BD8FF" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AnchorOrbitBrush">
            <GradientStop Color="#00FFFFFF" Offset="0.58" />
            <GradientStop Color="#79FFFFFF" Offset="0.68" />
            <GradientStop Color="#26A9D8FF" Offset="0.76" />
            <GradientStop Color="#00FFFFFF" Offset="0.84" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="DockGlassBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#EFFFFFFF" Offset="0" />
            <GradientStop Color="#DCEAF5FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WheelDrawerMask"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#FFFFFFFF" Offset="0.08" />
            <GradientStop Color="#FFFFFFFF" Offset="0.92" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="MenuShadow"
                          BlurRadius="24"
                          ShadowDepth="8"
                          Direction="270"
                          Opacity="0.18"
                          Color="#254E91" />
        <DropShadowEffect x:Key="ActionShadow"
                          BlurRadius="13"
                          ShadowDepth="3"
                          Direction="270"
                          Opacity="0.20"
                          Color="#315D8D" />

        <Style x:Key="RadialActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ActionRoot"
                              RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionRoot"
                                        Property="Opacity"
                                        Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionRoot"
                                        Property="Opacity"
                                        Value="0.82" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockLauncherButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#D9FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MenuStrongBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DockButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DockButtonSurface"
                                        Property="Background"
                                        Value="#FFFFFFFF" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MenuRoot"
          Width="660"
          Height="560"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="MenuScaleTransform"
                            ScaleX="0.97"
                            ScaleY="0.97" />
        </Grid.RenderTransform>

        <Canvas x:Name="MenuCanvas"
                Width="660"
                Height="560">
            <Path x:Name="FanWash"
                  Fill="{StaticResource MenuFanBrush}"
                  IsHitTestVisible="False"
                  Opacity="0.68">
                <Path.Effect>
                    <BlurEffect Radius="12" />
                </Path.Effect>
            </Path>

            <Path x:Name="ActionBeamsPath"
                  Fill="{StaticResource ActionBeamBrush}"
                  IsHitTestVisible="False"
                  Opacity="1">
                <Path.Effect>
                    <BlurEffect Radius="5" />
                </Path.Effect>
            </Path>

            <Ellipse x:Name="AnchorHalo"
                     Width="188"
                     Height="188"
                     Fill="{StaticResource AnchorHaloBrush}"
                     IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="22" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="AnchorOrbitOuter"
                     Width="184"
                     Height="184"
                     Fill="{StaticResource AnchorOrbitBrush}"
                     IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="4" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="AnchorOrbitInner"
                     Width="146"
                     Height="146"
                     Fill="{StaticResource AnchorOrbitBrush}"
                     IsHitTestVisible="False"
                     Opacity="0.72">
                <Ellipse.Effect>
                    <BlurEffect Radius="2" />
                </Ellipse.Effect>
            </Ellipse>
            <ScrollViewer x:Name="WheelLauncherScroller"
                          Width="234"
                          Height="380"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          ClipToBounds="True"
                          OpacityMask="{StaticResource WheelDrawerMask}"
                          PreviewMouseWheel="OnWheelLauncherMouseWheel">
                <StackPanel x:Name="WheelLauncherPanel"
                            Orientation="Vertical"
                            HorizontalAlignment="Stretch" />
            </ScrollViewer>

            <Button x:Name="RegionCaptureButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnRegionCaptureClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuGreenBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE722;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="快速截图"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="WindowCaptureButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnWindowCaptureClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuBlueBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE7C4;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="窗口"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="MonitorCaptureButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnMonitorCaptureClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuBlueBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE7F4;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="屏幕"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="AiButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnAiClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuVioletBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE8BD;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="AI 网页"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="NotesButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnNotesClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuCoralBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE70B;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="记事本"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="InputLockButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnInputLockClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="InputLockGlyphHost"
                            Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuBlueBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock x:Name="InputLockGlyph"
                                   Text="&#xE72E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="19"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock x:Name="InputLockTitle"
                                   Text="锁定英文"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="SettingsButton"
                    Width="196"
                    Height="48"
                    Style="{StaticResource RadialActionButtonStyle}"
                    Click="OnSettingsClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource MenuSlateBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Effect="{StaticResource ActionShadow}">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            Margin="6,3,0,3"
                            Background="{StaticResource MenuLabelBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="17"
                            Padding="14,0">
                        <TextBlock Text="设置"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Border x:Name="LauncherDock"
                    Width="480"
                    Height="64"
                    Background="{StaticResource DockGlassBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="18"
                    Padding="10,7">
                <Border.Effect>
                    <StaticResource ResourceKey="MenuShadow" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="快捷应用"
                                   Foreground="{StaticResource MenuStrongBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="LauncherCountText"
                                   Foreground="{StaticResource MenuMutedBrush}"
                                   FontSize="11"
                                   Text="0 个项目" />
                    </StackPanel>
                    <ScrollViewer x:Name="LauncherScroller"
                                  Grid.Column="1"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  PanningMode="HorizontalOnly"
                                  PreviewMouseWheel="OnLauncherMouseWheel">
                        <StackPanel x:Name="LauncherPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
